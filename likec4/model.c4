/**
 * Оценка типового интернет-магазина — та, на которой идёт разбор.
 *
 * Растёт вместе с уроком: на каждом шаге здесь появляется ровно то, что видно
 * на его схеме, и ни одного элемента впрок.
 *
 * Цвета по видам контекста в модели не заданы намеренно: про core, supporting
 * и generic урок говорит на своём шаге, и до него различие не должно быть
 * видно на карточках. Показывают его теги, которые включает тот шаг.
 */
model {
  customer = actor 'Customer'

  shop = context 'Online shop' {
    catalogue = service 'Catalogue' {
      #core
    }

    billing = service 'Billing' {
      #core
    }

    delivery = service 'Delivery' {
      #supporting
    }
  }

  /**
   * Авторизация стоит снаружи магазина: это готовый сервис, который покупают,
   * и внутрь границы он не входит.
   */
  auth = external 'Auth' {
    #generic
  }

  /**
   * Порядок такой: сперва клиент логинится, потом идёт в магазин. Стрелки от
   * магазина к авторизации нет намеренно — на этом шаге разговор про виды
   * контекста, а не про то, кто у кого проверяет токен.
   */
  customer -[calls]-> auth 'login'
  customer -[calls]-> shop 'shops'

  // Платёж: он и есть то слово, из-за которого весь разбор.
  customer -[calls]-> shop.billing 'payment'
}
