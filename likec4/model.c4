/**
 * Оценка типового интернет-магазина — та, на которой идёт разбор.
 *
 * Растёт вместе с уроком: на каждом шаге здесь появляется ровно то, что видно
 * на его схеме, и ни одного элемента впрок.
 *
 * Цвета по видам контекста в модели не заданы намеренно: про core, supporting
 * и generic урок говорит на своём шаге, и до него различие не должно быть
 * видно на карточках. Показывают его теги, которые включает тот шаг.
 */
model {
  customer = actor 'Customer'

  shop = context 'Online shop' {

    /**
     * Ограниченные контексты магазина: границы проходят здесь, вокруг каждой
     * области, а не вокруг магазина целиком — магазин это система.
     *
     * Подпись «bounded context» ставится в заголовке и только в тех view, где
     * контекст раскрыт рамкой: на рамке LikeC4 показывает один заголовок, а
     * описание не рисует вовсе; на карточке эта подпись не нужна.
     */
    catalogue = service 'Catalogue' {
      #core
    }

    /**
     * Домены биллинга — слова из его же словаря. Других здесь не появится:
     * контекст разговаривает только теми, что в словаре записаны.
     */
    billing = service 'Billing' {
      #core

      /**
       * Виды есть и у доменов: внутри core-контекста не всё core. Счёт и
       * платёж — то, ради чего биллинг существует; сверка нужна, но
       * преимущества не даёт.
       */
      invoice = domain 'Invoice' {
        #domain
        #core
      }

      payment = domain 'Payment' {
        #domain
        #core
      }

      settlement = domain 'Settlement' {
        #domain
        #supporting
      }

      /**
       * База у каждого домена своя и стоит здесь же, внутри границы биллинга.
       * Вложить её в сам домен нельзя: LikeC4 запрещает связь от элемента к
       * своему потомку, а связь нужна — она и говорит, чья это база.
       */
      invoice_db = store 'invoice-pg' {
        technology 'postgres'
      }

      payment_db = store 'payment-pg' {
        technology 'postgres'
      }

      settlement_db = store 'settlement-pg' {
        technology 'postgres'
      }
    }

    delivery = service 'Delivery' {
      #supporting
    }
  }

  /** Шина: место, где факт живёт между тем, кто его сказал, и кто услышал. */
  bus = broker 'bus'

  /** Деньги двигает провайдер, биллинг только просит и ждёт ответа. */
  provider = external 'Payments provider' {
    technology 'HTTP'
  }

  /**
   * Авторизация стоит снаружи магазина: это готовый сервис, который покупают,
   * и внутрь границы он не входит.
   */
  auth = external 'Auth' {
    #generic
  }

  /**
   * Порядок такой: сперва клиент логинится, потом идёт в магазин. Стрелки от
   * магазина к авторизации нет намеренно — на этом шаге разговор про виды
   * контекста, а не про то, кто у кого проверяет токен.
   */
  customer -[calls]-> auth 'login'
  customer -[calls]-> shop 'shops'

  // Платёж: он и есть то слово, из-за которого весь разбор.
  customer -[calls]-> shop.billing 'payment'

  /**
   * База у каждого домена своя и стоит внутри его границы. Общей базы у
   * сервиса нет: «не лезь в чужие таблицы» перестаёт быть договорённостью,
   * потому что чужих таблиц просто нет рядом.
   */
  shop.billing.invoice -[persists]-> shop.billing.invoice_db 'invoices, lines'
  shop.billing.payment -[persists]-> shop.billing.payment_db 'payments, attempts'
  shop.billing.settlement -[persists]-> shop.billing.settlement_db 'statements'

  // Факты уходят на шину; кто подписан, автор факта не знает.
  shop.catalogue -[publishes]-> bus 'order placed'
  bus -[consumes]-> shop.billing 'order placed'
  shop.billing -[publishes]-> bus 'invoice paid'

  bus -[consumes]-> shop.delivery 'invoice paid'

  shop.billing.payment -[calls]-> provider 'authorize, capture'

  /**
   * Та же связь, но от контекста целиком. Нужна итоговому кадру: стрелка из
   * домена внутрь рамки держит провайдера в одном ряду с рамкой, а от самого
   * биллинга он уходит в ряд под ней — туда, где ему и место.
   */
  shop.billing -[calls]-> provider 'authorize, capture'

  /**
   * Сервис скрейпинг-джоб — разбор системного дизайна.
   *
   * Живёт в той же модели, что и магазин: LikeC4 держит один проект на каталог,
   * и второй системе здесь не тесно — пересечений по идентификаторам нет.
   *
   * Как и у магазина, элементы появляются по мере разбора: каждый следующий кадр
   * добавляет ровно один. Ничего впрок.
   */
  scrapeUser = actor 'User'

  /** Чужие API: медленные, ненадёжные, лимитирующие. Мы их не контролируем. */
  targets = external 'Target APIs' {
    technology 'HTTP'
  }

  scraper = context 'Scraping service' {

    /*
     * Имена — как у сервисов в репозитории и в деплое, в одном стиле с
     * `jobs-pg` и `results-s3`. Пишущая и читающая стороны названы терминами
     * CQRS, `job-command` и `job-query`: по имени сразу видно, какая это сторона.
     */
    /** Точка входа: принимает запрос пользователя и раздаёт его внутрь. */
    gateway = service 'api-gateway'

    /**
     * Командная сторона CQRS: единственный, кто пишет джобу. В целевые API не
     * ходит никогда — иначе медленная цель становится медленным приёмом.
     */
    command = service 'job-command'

    /**
     * Читающая сторона: статусы и история попыток. Отдельно от командной,
     * потому что читают на порядок чаще, чем пишут.
     */
    reader = service 'job-query'

    /**
     * Публикует в шину события по строкам jobs, которые ещё не опубликованы.
     * Отдельный процесс: так ни приём, ни воркер не пишут в шину сами, и
     * двойной записи «база + брокер» нет нигде.
     */
    publisher = service 'job-publisher'

    /** Пул: берёт джобу, ходит в цель, складывает результат, двигает статус. */
    worker = service 'scrape-worker'

    /**
     * Планировщик: решает, какая джоба поедет следующей, когда попытки
     * кончились и что делать с зависшими. Возврат зависших — крон-модуль
     * внутри него; на C2 модули не рисуют, это уровень C3.
     */
    scheduler = service 'job-scheduler' {

      /** Крон-модуль из шага про аренду: возвращает зависшие джобы. */
      sweeper = component 'stuck-sweeper'

      /** Судьба неудачной попытки: следующая с backoff или `failed`. */
      retries = component 'retry-planner'

      /** Единственный модуль, который ходит в базу. */
      repo = component 'jobs-repository'
    }

    /**
     * Одна база: джобы и попытки. Строка jobs сама служит outbox: колонки
     * `published_at` и `finish_published_at` показывают, какое событие по ней
     * ещё не ушло в шину. Изменение состояния и отметка «опубликовать» — одна
     * запись в одной строке, и отдельная таблица для этого не нужна.
     */
    jobs_db = store 'jobs-pg' {
      technology 'postgres'
    }

    /**
     * Шина: очередь работы и очередь фактов о её итогах.
     *
     * Внутри границы, а не сбоку от неё: очередь наша — мы её разворачиваем,
     * настраиваем и чиним. Снаружи стоит то, чем мы не управляем, и шине там
     * не место.
     */
    mq = broker 'MQ'

    /** Результаты: терабайты, которым нечего делать в базе состояний. */
    results = store 'results-s3' {
      technology 's3'
    }
  }


  /*
   * Стрелка идёт туда, куда едут данные. Запись — от сервиса к хранилищу,
   * чтение — от хранилища к сервису, публикация — в шину, потребление — из
   * шины (так же нарисован магазин: `bus -> billing`). Синхронный вызов — от
   * вызывающего к вызываемому.
   *
   * Вид связи — `write` или `read` — задаёт ещё и цвет. Вызов относится к тому
   * пути, который открывает: «submit» ведёт к записи, «status» — к чтению.
   */
  /*
   * Две линии от пользователя вместо одной: они же легенда цвета. LikeC4
   * сливает связи одной пары элементов в одну серую линию со счётчиком,
   * поэтому на каждом кадре остаётся только та, о которой кадр (см. views).
   */
  scrapeUser -[write]-> scraper.gateway 'write: submit job'
  scrapeUser -[read]-> scraper.gateway 'read: status, result'

  scraper.gateway -[write]-> scraper.command 'create job'
  scraper.gateway -[read]-> scraper.reader 'status, list'

  scraper.command -[write]-> scraper.jobs_db 'job, published_at = null'
  scraper.jobs_db -[read]-> scraper.reader 'status, attempts'

  // Публикатор — единственный, кто пишет в шину: оба события берутся из строк
  // jobs, где отметка публикации ещё пустая.
  scraper.jobs_db -[read]-> scraper.publisher 'unpublished rows'
  // После отправки публикатор отмечает строку: между этими двумя шагами окно,
  // из которого берётся повторная доставка.
  scraper.publisher -[write]-> scraper.jobs_db 'published_at = now()'
  scraper.publisher -[write]-> scraper.mq 'job queued, job finished'

  scraper.mq -[read]-> scraper.worker 'job queued'
  scraper.worker -[read]-> targets 'fetch'
  scraper.worker -[write]-> scraper.results 'payload'
  // Результат клиент скачивает из хранилища сам, по подписанной ссылке:
  // данные в наше API не заходят.
  scraper.results -[read]-> scrapeUser 'read: result by presigned URL'
  scraper.worker -[write]-> scraper.jobs_db 'status, attempt, lease'

  /*
   * Связи планировщика — от модулей. На C2, где планировщик одной коробкой,
   * LikeC4 сам поднимает их до сервиса: отдельная связь от сервиса дала бы на
   * C3 вторую стрелку в базу прямо от рамки.
   */
  scraper.scheduler.sweeper -[calls]-> scraper.scheduler.repo 'expired leases'
  scraper.scheduler.retries -[calls]-> scraper.scheduler.repo 'failed attempts'
  scraper.jobs_db -[read]-> scraper.scheduler.repo 'expired leases, failed attempts'
  scraper.scheduler.repo -[write]-> scraper.jobs_db 'queued / failed, published_at = null'
}
