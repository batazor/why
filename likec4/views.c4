/**
 * По одному view на экран урока. Имя view совпадает с id шага в колоде:
 * связь проверяет scripts/check-steps.mjs.
 */
views {
  /**
   * Экран `context`: где проходит граница и что её пересекает.
   *
   * Контексты показаны рамками, внутри каждой — сервис. Рамка, а не карточка,
   * потому что владеет именно контекст: сервис в нём сегодня один, а завтра их
   * может быть три, и для соседа это ничего не меняет.
   */
  view context {
    title 'Bounded contexts'

    include
      customer,
      auth,
      auth.api,
      shop,
      shop.cart,
      risk,
      bus

    // Факт, на который auth реагирует сам, — механика политики, и она
    // обсуждается ниже. На экране про границу видно только то, что контекст
    // отдаёт наружу.
    exclude bus -> auth.api

    autoLayout LeftRight
  }
}
