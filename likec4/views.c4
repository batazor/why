/**
 * По одному view на экран урока. Какой шаг какой view показывает, объявляет
 * колода; связь проверяет scripts/check-steps.mjs.
 */
views {
  /**
   * Экран `boundary`: один блок.
   *
   * Разговор о том, чем граница является, и на схеме ровно одна граница —
   * магазин. Что у него внутри, на этом шаге не обсуждается.
   */
  view boundary {
    title 'One boundary'

    include shop

    autoLayout LeftRight
  }

  /**
   * Экран `estate`: клиент приходит в магазин, внутри магазина три области.
   *
   * Стрелка одна и ведёт в магазин целиком: кто внутри с кем разговаривает —
   * вопрос следующих экранов.
   */
  view estate {
    title 'Inside the shop'

    include
      customer,
      shop,
      shop.catalogue,
      shop.billing,
      shop.delivery

    exclude customer -> shop.billing

    autoLayout LeftRight
  }

  /**
   * Экран `kinds`: те же области, плюс авторизация.
   *
   * Она снаружи магазина и с лейблом `generic`: решённая задача, которую
   * покупают. Без неё третий вид контекста пришлось бы объяснять словами, не
   * показав ни одного примера.
   */
  view kinds {
    title 'Core, supporting, generic'

    include
      customer,
      shop,
      shop.catalogue,
      shop.billing,
      shop.delivery,
      auth

    exclude customer -> shop.billing

    autoLayout LeftRight
  }

  /**
   * Экран `language`: движение платежа от клиента к биллингу.
   *
   * Тот же кадр, что и `estate`, но стрелка идёт не в магазин целиком, а в ту
   * область, которая словом «платёж» и распоряжается.
   */
  view language {
    title 'A payment arrives'

    include
      customer,
      shop,
      shop.catalogue,
      shop.billing,
      shop.delivery

    exclude customer -> shop

    autoLayout LeftRight
  }
}
