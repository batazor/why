/**
 * Виды элементов и связей для схем урока.
 *
 * Модель — общий для локалей ассет, как колода кода и схема на React Flow:
 * значит в ней только английский и только идентификаторы. Проза переводится и
 * живёт в нарративе урока, поэтому в title и description ей места нет.
 */
specification {
  /**
   * Три вида контекста по тому, что он значит для бизнеса. Цвет — не украшение:
   * `core` отличается от остальных двух сильнее, чем они друг от друга, потому
   * что решение «делать самим или купить» принимается по этому различию.
   */
  tag core
  tag supporting
  tag generic
  /** Лейбл домена: карточка внутри контекста — домен, а не сервис. */
  tag domain
  /**
   * Лейбл границы. Описание в карточке видно, только пока она одиночная: у
   * рамки с содержимым остаётся один заголовок, и надпись на ней держится
   * тегом.
   */
  tag bounded-context

  color core #4a86c8
  color supporting #6b7cb4
  color generic #8a8f99

  /**
   * Ограниченный контекст — рамка, а не карточка: владеет им контекст, а
   * сервисов внутри может быть и три. Прозрачная заливка работает только у
   * составных узлов, поэтому в view контекст всегда показывается вместе с тем,
   * что внутри него.
   */
  element context {
    style {
      shape rectangle
      opacity 10%
      border dashed
    }
  }

  element service {
    style {
      shape rectangle
      size xs
    }
  }

  /**
   * Домен внутри контекста: своё состояние, свои правила, своя папка. В коде
   * это вертикальный слайс со всеми своими слоями.
   */
  element domain {
    style {
      shape rectangle
      opacity 20%
    }
  }

  /**
   * Модуль внутри сервиса — уровень C3. На C2 его не видно: там сервис одной
   * коробкой, а модули появляются, когда спускаются внутрь.
   */
  element component {
    style {
      shape rectangle
      size xs
      opacity 30%
    }
  }

  element aggregate {
    style {
      shape rectangle
      opacity 25%
    }
  }

  element event {
    style {
      shape rectangle
      opacity 30%
      color green
    }
  }

  /**
   * Человечек в карточке — фигура 115x120, и LikeC4 сажает её от нижнего края:
   * при `xs` (180x100) голова уезжает за верх карточки и срезается. `sm` —
   * первый размер, в который фигура помещается целиком.
   */
  element actor {
    style {
      shape person
      color muted
      size sm
    }
  }

  element store {
    style {
      shape storage
      color muted
      size xs
    }
  }

  element broker {
    style {
      shape queue
      color muted
      size xs
    }
  }

  element external {
    style {
      shape rectangle
      color muted
      border dashed
      size xs
    }
  }

  relationship calls
  relationship consumes
  /**
   * Чтение и запись — цветом. Нужны разбору задачи, где на одной схеме
   * встречаются оба пути, и без цвета не видно, где джоба пишется, а где её
   * только читают. Остальные виды связей цвета не несут: схемы магазина в
   * главах про DDD остаются как были.
   */
  relationship read {
    color sky
    line solid
  }
  relationship write {
    color amber
    line solid
  }
  relationship publishes
  relationship persists
  relationship owns
  relationship refers
}
