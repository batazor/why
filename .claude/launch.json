{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "why-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "why-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4399"
      ],
      "port": 4399
    },
    {
      "name": "why-dev-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PUBLIC_SUPABASE_URL=",
        "PUBLIC_SUPABASE_ANON_KEY=",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "4322"
      ],
      "port": 4322
    }
  ]
}
