{
  "name": "why",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run likec4:gen",
    "build": "node scripts/check-steps.mjs && astro build",
    "prebuild": "npm run likec4:gen",
    "preview": "astro preview",
    "likec4:gen": "likec4 gen react likec4 -o src/likec4/generated.jsx --no-use-dot",
    "likec4:validate": "likec4 validate likec4",
    "check:steps": "node scripts/check-steps.mjs",
    "check:types": "astro check",
    "check:pricing": "node scripts/check-pricing.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@shikijs/transformers": "^4.4.3",
    "@xyflow/react": "^12.11.6",
    "astro": "^7.3.2",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "js-yaml": "^5.4.2",
    "likec4": "^1.59.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
