---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import StepPlayer from '../../../components/StepPlayer.astro';
import Quiz from '../../../components/Quiz.astro';
import Incidents from '../../../components/Incidents.astro';
import Brief from '../../../components/Brief.astro';
import Comments from '../../../components/Comments.astro';
import Chapters from '../../../components/Chapters';
import FlowDiagram from '../../../components/FlowDiagram';
import { getDeck } from '../../../code/registry';
import { useTranslations, isLocale, localePath, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  // Соседи считаются здесь, а не на странице: порядок каталога должен быть
  // один и тот же в обоих местах, а значит и считаться должен один раз.
  const byLocale = new Map<string, typeof lessons>();
  for (const lesson of lessons) {
    const lang = lesson.id.split('/')[0];
    byLocale.set(lang, [...(byLocale.get(lang) ?? []), lesson]);
  }
  for (const list of byLocale.values()) {
    list.sort((a, b) => a.data.order - b.data.order);
  }

  return lessons.map((lesson) => {
    const [lang, ...rest] = lesson.id.split('/');
    /**
     * Соседи считаются по серии, если урок — глава книги.
     *
     * Внутри серии порядок задан главами, а не каталогом, и черновики из него
     * не выбрасываются: пока книга пишется, соседних глав иначе нет вовсе.
     */
    const series = lesson.data.series
      ? byLocale.get(lang)!.filter((item) => item.data.series === lesson.data.series)
      : undefined;
    const siblings = series ?? byLocale.get(lang)!.filter((item) => !item.data.draft);
    const index = siblings.findIndex((item) => item.id === lesson.id);

    return {
      params: { lang, slug: rest.join('/') },
      props: {
        lesson,
        prev: index > 0 ? siblings[index - 1] : undefined,
        next: index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined,
        chapters: (series ?? []).map((item) => ({
          slug: item.id.slice(lang.length + 1),
          title: item.data.title,
        })),
      },
    };
  });
}

interface Props {
  lesson: CollectionEntry<'lessons'>;
  prev?: CollectionEntry<'lessons'>;
  next?: CollectionEntry<'lessons'>;
  /** Главы серии, если урок в неё входит. */
  chapters?: { slug: string; title: string }[];
}

const { lesson, prev, next, chapters = [] } = Astro.props;
const { lang: langParam, slug } = Astro.params;
if (!isLocale(langParam)) throw new Error(`Unknown locale: ${langParam}`);
const lang: Locale = langParam;
const t = useTranslations(lang);

const deck = getDeck(lesson.data.deck ?? slug!);
const poster = deck.poster;

// Тексты пометок — проза, поэтому берутся из локализованного урока, а не из
// спеки схемы. Номер совпадает с номером шага в плеере.
const notes = lesson.data.steps
  .map((step, i) => ({ step: step.id, level: i + 1, text: step.note ?? '' }))
  .filter((note) => note.text);

const drags = lesson.data.steps
  .filter((step) => step.drag)
  .map((step) => ({ step: step.id, ...step.drag! }));

/**
 * Документы сервиса для редактора: файлы дерева без кода.
 *
 * Содержимое — проза этой локали, поэтому берётся из коллекции `docs` и
 * рендерится здесь: отрендерить markdown можно только там, где доступен
 * `render`, а это страница.
 */
const docs = await Promise.all(
  (deck.tree?.files ?? [])
    .filter((file) => file.code === undefined)
    .map(async (file) => {
      const id = `${lang}/${slug}/${file.path.replace(/\.md$/, '')}`;
      const entry = await getEntry('docs', id);
      if (!entry) throw new Error(`Нет документа src/content/docs/${id}.md для файла ${file.path}`);
      const { Content } = await render(entry);
      return { path: file.path, Content };
    }),
);

const { Content } = await render(lesson);

const siblingHref = (entry: CollectionEntry<'lessons'>) =>
  localePath(lang, `lessons/${entry.id.slice(lang.length + 1)}`);
---

<Base
  lang={lang}
  title={lesson.data.title}
  description={lesson.data.description}
  path={`lessons/${slug}`}
>
  <Comments lang={lang} />

  <article>
    <h1>{lesson.data.title}</h1>

    {/* Остров: меню держит Popover, и он же закрывается по Escape и щелчку
        снаружи. Ссылки глав считает страница — у неё есть локаль и base.
        Урок вне серии острова не получает вовсе: одной главе оглавление не
        нужно, а грузить ради него React незачем. */
    chapters.length > 1 && (
      <Chapters
        client:load
        label={t('lesson.chapters')}
        current={slug!}
        chapters={chapters.map((chapter) => ({
          ...chapter,
          href: localePath(lang, `lessons/${chapter.slug}`),
        }))}
      />
    )}

    {/* Разбор задачи открывается заданием, разбор паттерна — болью. Место у них
        одно: и то, и другое отвечает на «зачем я это читаю», и два блока подряд
        об одном читатель воспринимает как повтор. */}
    {
      lesson.data.brief ? (
        <Brief
          label={lesson.data.brief.label}
          source={lesson.data.brief.source}
          text={lesson.data.brief.text}
        />
      ) : (
        <div class:list={['callout', poster && 'callout--illustrated']}>
          <div class="callout__body">
            <span class="callout__label">{t('catalog.problem')}</span>
            {lesson.data.problem}
          </div>
          {poster && (
            /* Постер дублирует текст рядом, поэтому для скринридера он декоративный. */
            <figure class="callout__figure" aria-hidden="true">
              <FlowDiagram client:visible spec={poster} labels={lesson.data.labels} />
            </figure>
          )}
        </div>
      )
    }

    <Incidents lang={lang} items={lesson.data.incidents} />

    <div class="prose" data-terms={JSON.stringify(lesson.data.terms)}>
      <Content />
    </div>

    {/* Заголовка у разбора нет: к этому месту текст урока уже сказал, что
        дальше разбор, и повторять это строкой «Разбор по шагам» незачем.
        Ориентир для скринридера остался — он на самой секции плеера. */}
    <StepPlayer
      lang={lang}
      steps={lesson.data.steps}
      deck={deck.default}
      flow={deck.flow}
      likec4={deck.likec4}
      tree={deck.tree}
      docs={docs}
      notes={notes}
      comments={lesson.data.comments}
      drags={drags}
      labels={lesson.data.labels}
      widgets={deck.widgets}
    />

    <Quiz lang={lang} slug={slug!} items={lesson.data.quiz} />

    <nav class="lesson-nav" aria-label={t('nav.allLessons')}>
      {
        prev ? (
          <a class="lesson-nav__link lesson-nav__link--prev" href={siblingHref(prev)}>
            <span class="lesson-nav__label">
              ← {chapters.length ? t('nav.prevChapter') : t('nav.prevLesson')}
            </span>
            <span class="lesson-nav__title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      <a class="lesson-nav__home" href={localePath(lang)}>{t('nav.allLessons')}</a>
      {
        next ? (
          <a class="lesson-nav__link lesson-nav__link--next" href={siblingHref(next)}>
            <span class="lesson-nav__label">
              {chapters.length ? t('nav.nextChapter') : t('nav.nextLesson')} →
            </span>
            <span class="lesson-nav__title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>

<script>
  /**
   * Тултипы терминов. Слово в тексте помечено `data-term="ключ"`, определение
   * лежит в глоссарии урока (frontmatter `terms`) и приезжает сюда JSON'ом.
   *
   * Разметку строит скрипт, а не автор: иначе одно и то же определение пришлось
   * бы дублировать в каждом упоминании, и они бы разъехались.
   */
  const prose = document.querySelector<HTMLElement>('.prose[data-terms]');
  /**
   * Термины помечаются и в тексте урока, и в нарративе шагов: правило про одно
   * значение слова касается всей страницы, а не только вступления. Глоссарий
   * при этом один и приезжает на `.prose`.
   */
  const scope = document.querySelector<HTMLElement>('article');

  if (prose && scope) {
    const glossary: Record<string, string> = JSON.parse(prose.dataset.terms || '{}');
    let open: HTMLElement | null = null;

    const hide = () => {
      if (open) open.dataset.open = 'false';
      open = null;
    };

    scope.querySelectorAll<HTMLElement>('[data-term]').forEach((el, i) => {
      const definition = glossary[el.dataset.term!];
      // Слова без определения остаются обычным текстом: пунктир обещает
      // расшифровку, и пустой тултип это обещание нарушал бы.
      if (!definition) return;

      el.classList.add('term');
      el.tabIndex = 0;

      const tip = document.createElement('span');
      tip.className = 'term__tip';
      tip.id = `term-${i}`;
      tip.setAttribute('role', 'tooltip');
      tip.textContent = definition;
      el.append(tip);
      el.setAttribute('aria-describedby', tip.id);

      const show = () => {
        hide();
        // Сдвиг сбрасывается до замера: иначе второе открытие считает
        // положение от уже сдвинутой подсказки и уезжает дальше.
        tip.style.left = '';
        tip.dataset.placement = 'above';
        el.dataset.open = 'true';
        open = el;

        /* Замеры после открытия: закрытая подсказка не показывается вовсе
           (display:none), иначе её край растягивал бы прокрутку страницы.
           Правки стиля идут в том же кадре, поэтому промежуточное положение
           читатель не видит. */
        if (tip.getBoundingClientRect().top < 8) tip.dataset.placement = 'below';

        const overflow = tip.getBoundingClientRect().right - (window.innerWidth - 8);
        if (overflow > 0) tip.style.left = `${-overflow}px`;

        // И то же самое у левого края: термин в начале строки уводил сдвинутую
        // подсказку за экран влево, а прокрутки влево не бывает.
        const left = tip.getBoundingClientRect().left;
        if (left < 8) tip.style.left = `${parseFloat(tip.style.left || '0') + (8 - left)}px`;
      };

      el.addEventListener('pointerenter', show);
      el.addEventListener('focus', show);
      el.addEventListener('pointerleave', hide);
      el.addEventListener('blur', hide);
      // Тач: наведения нет, поэтому тап переключает.
      el.addEventListener('click', () => (el.dataset.open === 'true' ? hide() : show()));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hide();
    });
    window.addEventListener('scroll', hide, { passive: true });
    /* Ресайз и поворот экрана: сдвиг посчитан для прежней ширины, и держать
       подсказку с ним — значит держать её за краем. */
    window.addEventListener('resize', hide);
  }
</script>
