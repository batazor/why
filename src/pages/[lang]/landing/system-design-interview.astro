---
import Base from '../../../layouts/Base.astro';
import { locales, localePath, assetPath, type Locale } from '../../../i18n/ui';
import FeatureGrid from '../../../components/landing/FeatureGrid.astro';
import Icon from '../../../components/landing/Icon.astro';
import BoardDemo from '../../../components/landing/BoardDemo.astro';
import AssistantDemo from '../../../components/landing/AssistantDemo.astro';
import ReportDemo from '../../../components/landing/ReportDemo.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;

/**
 * Лендинг песочницы для собеседований по системному дизайну.
 *
 * Тексты живут здесь, а не в общем словаре: они нужны одной странице, и
 * словарь интерфейса от них только распух бы. Каждое утверждение — про то,
 * что песочница уже умеет: числа (27 блоков, оценка 0–3, веса ×2 и ×3, пять
 * шагов тренировки) взяты из её кода, и если там поменяются, менять и здесь.
 */
const copy = {
  ru: {
    title: 'Песочница для собеседований по системному дизайну',
    description:
      'Кандидат собирает систему в браузере, интервьюер видит его доску в реальном времени, открывает подсказки и ставит баллы по рубрике. После собеседования остаётся отчёт с записью доски.',
    eyebrow: 'Для команд, которые нанимают инженеров',
    heading: 'Собеседование по системному дизайну на одной доске',
    lead: 'Кандидат собирает схему у себя в браузере, а вы видите её в реальном времени: каждый блок, каждую стрелку и даже курсор. Тут же лежат эталон, подсказки и рубрика, так что ещё три вкладки держать не нужно. Когда собеседование закончится, у вас останется отчёт с баллами, заметками и записью того, как кандидат пришёл к своему решению.',
    open: 'Открыть песочницу',
    how: 'Как это работает',
    painTitle: 'Обычно это выглядит так',
    pain: [
      'Кандидат рисует в Miro или Excalidraw.',
      'Задание и подсказки лежат в Notion.',
      'Критерии оценки в гугл-таблице.',
      'Заметки в блокноте или где придётся.',
    ],
    painAfter:
      'Пока кандидат объясняет, вы прыгаете между вкладками и пропускаете половину. Оценку заполняете уже после звонка, по памяти. Второй интервьюер читает те же критерии по-своему, и потом непонятно, кто прав. А как кандидат пришёл к решению, восстановить нельзя: осталась только финальная картинка. Здесь всё это на одной странице: задание, доска, подсказки, рубрика и запись.',
