      'Access is enforced by the database, not the UI: the candidate gets only the task and their own board — no reference, no rubric, no one else’s notes — and the task only after the start.',
      'A finished interview cannot be restarted, and the candidate’s board is frozen after the end.',
      'Without signing in the playground runs entirely in the browser: designs live in its storage, a scenario or an answer travels as a JSON file.',
    ],
    exampleTitle: 'What a worked problem looks like',
    example:
      'The scraping jobs write-up goes all the way: the task, questions, requirements, estimates, C1 → C2 → C3 and matching decisions to requirements.',
    exampleLink: 'Open the write-up',
    finalTitle: 'Start from a ready-made scenario',
    finalText: 'The playground has an example — a URL shortener with a reference, hints and a rubric. Switch roles without signing in; sign in with Google for a live interview.',
  },
}[lang];

const playground = localePath(lang, 'playground');


---

<Base lang={lang} title={copy.title} description={copy.description} path="landing/system-design-interview">
  <div class="landing">
    <section class="hero" data-reveal>
      <div class="hero__text">
        <p class="hero__eyebrow">{copy.eyebrow}</p>
        <h1 class="hero__title">{copy.heading}</h1>
        <p class="hero__lead">{copy.lead}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={playground}>{copy.open} →</a>
          <a class="hero__link" href="#flow">{copy.how}</a>
        </div>
      </div>
      <figure class="hero__art" aria-hidden="true">
        <img src={assetPath('covers/system-design-interview.svg')} alt="" width="640" height="300" />
      </figure>
    </section>

    <section class="pain" data-reveal>
      <h2>{copy.painTitle}</h2>
      <ul>{copy.pain.map((item) => <li>{item}</li>)}</ul>
      <p>{copy.painAfter}</p>
    </section>

    <section class="roles" data-reveal>
      <h2>{copy.rolesTitle}</h2>
      <div class="roles__grid">
        {
          copy.roles.map((role) => (
            <article class={`role role--${role.key}`} data-reveal-item>
              <h3>{role.name}</h3>
              <ul>{role.points.map((point) => <li>{point}</li>)}</ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="features" data-reveal>
      <h2>{copy.liveTitle}</h2>
      <FeatureGrid cards={copy.live} />
    </section>

    <section class="ai" data-reveal>
      <h2>{copy.aiTitle}</h2>
      <div class="ai__grid">
        {
          copy.ai.map((card) => (
            <article class="ai__card" data-reveal-item>
              <div class="ai__top">
                <span class="ai__tile">
                  <Icon name="spark" />
                </span>
                <h3>{card.name}</h3>
              </div>
              <ul>{card.points.map((point) => <li>{point}</li>)}</ul>
            </article>
          ))
        }
      </div>
      <p class="ai__keys">{copy.aiKeys}</p>
    </section>

    <section class="features" data-reveal>
      <h2>{copy.featuresTitle}</h2>
      <FeatureGrid cards={copy.features} />
    </section>

    <section class="practice" data-reveal>
      <h2>{copy.practiceTitle}</h2>
      <p class="practice__lead">{copy.practiceLead}</p>
      <ul class="practice__list">{copy.practice.map((item) => <li data-reveal-item>{item}</li>)}</ul>
    </section>

    <section class="flow" id="flow" data-reveal>
      <h2>{copy.flowTitle}</h2>
      <ol class="flow__list">
        {
          copy.flow.map(([name, text], i) => (
            <li class="flow__step" data-reveal-item>
              <span class="flow__num">{i + 1}</span>
              <div>
                <h3>{name}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="aside-pair" data-reveal>
      <article class="note">
        <h2>{copy.privacyTitle}</h2>
        {copy.privacy.map((item) => <p>{item}</p>)}
      </article>
      <article class="note">
        <h2>{copy.exampleTitle}</h2>
        <p>{copy.example}</p>
        <a class="hero__link" href={localePath(lang, 'lessons/scraping-jobs')}>{copy.exampleLink} →</a>
      </article>
    </section>

    <section class="final" data-reveal>
      <h2>{copy.finalTitle}</h2>
      <p>{copy.finalText}</p>
      <a class="btn btn--primary" href={playground}>{copy.open} →</a>
    </section>
  </div>
</Base>

<script>
  import { animate, inView, stagger } from 'motion';

  /**
   * Секции проявляются, когда до них доскроллили; карточки внутри — одна за
   * другой. Без JS и при reduced motion всё видно сразу: скрытие ставит сам
   * скрипт, а не CSS.
   */
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((section) => {
      const items = section.querySelectorAll<HTMLElement>('[data-reveal-item]');
      section.style.opacity = '0';
      items.forEach((item) => (item.style.opacity = '0'));

      inView(
        section,
        () => {
          animate(section, { opacity: [0, 1], y: [18, 0] }, { duration: 0.5, ease: [0.22, 1, 0.36, 1] });
          if (items.length) {
            animate(
              items,
              { opacity: [0, 1], y: [14, 0] },
              { delay: stagger(0.07, { startDelay: 0.12 }), duration: 0.45, ease: [0.22, 1, 0.36, 1] },
            );
          }
        },
        { amount: 0.15 },
      );
    });
  }
</script>

<style>
  .landing {
    display: grid;
    gap: 4.5rem;
    padding: 1.5rem 0 3rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 1.45rem;
    letter-spacing: -0.01em;
  }

  h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }

  /* ---------- первый экран ---------- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }

  .hero__eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .hero__lead {
    margin: 1rem 0 0;
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.6rem;
  }

  .btn--primary {
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--panel);
    font-weight: 600;
    text-decoration: none;
  }

  /* Общее `.btn:hover` красит текст в синий — на синем фоне кнопки он
     пропадал. Здесь у кнопки свои цвета на все состояния: текст всегда
     светлый, меняется только фон. */
  .btn.btn--primary:hover:not(:disabled),
  .btn.btn--primary:focus-visible,
  .btn.btn--primary:active {
    border-color: color-mix(in srgb, var(--accent) 82%, var(--fg));
    background: color-mix(in srgb, var(--accent) 82%, var(--fg));
    color: var(--panel);
  }

  .hero__link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .hero__link:hover {
    text-decoration: underline;
  }

  /* Акварель на тёплой бумаге — как обложки разборов в каталоге. */
  .hero__art {
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: color-mix(in srgb, #efe6d6 55%, var(--panel));
    box-shadow: 0 10px 40px var(--shadow);
  }

  .hero__art img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- боль ---------- */

  .pain {
    max-width: 44rem;
  }

  .pain ul {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.7;
  }

  .pain p {
    margin: 1rem 0 0;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- роли ---------- */

  .roles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  /* Цвет роли — полоса сверху: те же три тона, что у кружков на иллюстрации. */
  .role {
    --role: #c9a24a;
    padding: 1.1rem 1.2rem 1.2rem;
    border: 1px solid var(--border);
    border-top: 3px solid var(--role);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .role--candidate {
    --role: #5b9bd0;
  }

  .role--interviewer {
    --role: #8a70c9;
  }

  .role ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .role li + li {
    margin-top: 0.35rem;
  }

  /* ---------- ИИ ---------- */

  .ai__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  /* Тон ИИ — лавандовый, как у роли интервьюера: помощник работает на него. */
  .ai__card {
    --tone: #8a70c9;
    padding: 1.15rem 1.2rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--tone) 22%, var(--border));
    border-radius: 14px;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--tone) 10%, transparent), transparent 60%),
      var(--panel);
  }

  .ai__top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.7rem;
  }

  .ai__top h3 {
    margin: 0;
  }

  .ai__tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--tone) 16%, var(--panel));
    color: var(--tone);
  }

  .ai__card ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .ai__card li + li {
    margin-top: 0.35rem;
  }

  .ai__keys {
    max-width: 44rem;
    margin: 1rem 0 0;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- тренировка ---------- */

  .practice {
    max-width: 44rem;
  }

  .practice__lead {
    margin: 0 0 0.8rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .practice__list {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.65;
  }

  .practice__list li + li {
    margin-top: 0.4rem;
  }

  /* ---------- ход собеседования ---------- */

  .flow__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }

  /* Шаги стоят на вертикальной линии: номер в кружке, линия между ними. */
  .flow__step {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.9rem;
    padding-bottom: 1.3rem;
  }

  .flow__step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 2.4rem;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }

  .flow__num {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
  }

  .flow__step h3 {
    margin-top: 0.45rem;
  }

  .flow__step p {
    margin: 0;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ---------- приватность и пример ---------- */

  .aside-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .note {
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .note h2 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .note p {
    margin: 0 0 0.6rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- финал ---------- */

  .final {
    padding: 2.2rem 1.5rem;
    border-radius: 16px;
    background: color-mix(in srgb, var(--accent-soft) 70%, var(--panel));
    text-align: center;
  }

  .final p {
    margin: 0 0 1.2rem;
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .hero,
    .aside-pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .roles__grid,
    .ai__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
