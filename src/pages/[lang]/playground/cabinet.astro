---
import Base from '../../../layouts/Base.astro';
import Cabinet from '../../../playground/Cabinet';
import { locales, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

{/* Кабинет интервьюера — подстраница песочницы, тоже целиком клиентская:
    всё, что в нём есть, приходит с сервера после входа. */}
<Base lang={lang} title={t('playground.cabinet')} description={t('playground.cabinetDescription')} path="playground/cabinet">
  <Cabinet client:only="react" lang={lang} />
</Base>
