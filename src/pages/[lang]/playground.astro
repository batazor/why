---
import Base from '../../layouts/Base.astro';
import Playground from '../../playground/Playground';
import { locales, useTranslations, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

{/* Песочница — целиком клиентская: проекты лежат в хранилище браузера, и
    рендерить на сервере нечего. */}
<Base lang={lang} title={t('nav.playground')} description={t('playground.description')} path="playground">
  <Playground client:only="react" lang={lang} />
</Base>
