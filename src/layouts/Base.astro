---
import '../styles/global.css';
import {
  locales,
  localeNames,
  defaultLocale,
  useTranslations,
  localePath,
  assetPath,
  type Locale,
} from '../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Путь БЕЗ префикса локали, например 'lessons/idempotency'. */
  path?: string;
}

const { lang, title, description, path = '' } = Astro.props;
const t = useTranslations(lang);

// Один и тот же `path` порождает и canonical, и все hreflang — поэтому версии
// физически не могут разъехаться.
const canonical = new URL(localePath(lang, path), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {t('site.title')}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Предзагружаем только то подмножество, которым написана эта локаль:
        грузить кириллицу на английской странице незачем. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={assetPath(lang === 'ru' ? 'fonts/caveat-cyrillic.woff2' : 'fonts/caveat-latin.woff2')}
    />
    {
      locales.map((loc) => (
        <link
          rel="alternate"
          hreflang={loc}
          href={new URL(localePath(loc, path), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(defaultLocale, path), Astro.site)}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content={lang} />

    <script is:inline>
      // Тема ставится до первой отрисовки, иначе при выбранной тёмной успевает
      // мигнуть светлая. Поэтому скрипт инлайновый и стоит в <head>.
      (() => {
        try {
          const saved = localStorage.getItem('why:theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          /* приватный режим — просто идём за системной темой */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t('nav.skip')}</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="site-header__brand" href={localePath(lang)}>{t('site.title')}</a>
        <span class="site-header__spacer"></span>
        {/* role="switch" вместо простой кнопки: у переключателя есть состояние,
            и скринридер должен назвать его. aria-checked проставляет скрипт —
            на сервере он неизвестен, пока тема приходит от системы. */}
        <button
          class="theme-toggle"
          type="button"
          role="switch"
          aria-checked="false"
          data-theme-toggle
          title={t('nav.theme')}
        >
          <span class="theme-toggle__thumb" aria-hidden="true"></span>
          <svg
            class="theme-toggle__icon theme-toggle__icon--sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4.2" fill="currentColor" stroke="none"></circle>
            <path
              d="M12 2.4v2.3M12 19.3v2.3M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.4 12h2.3M19.3 12h2.3M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"
            ></path>
          </svg>
          <svg
            class="theme-toggle__icon theme-toggle__icon--moon"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M20.3 14.6A8.6 8.6 0 0 1 9.4 3.7a7.7 7.7 0 1 0 10.9 10.9Z"></path>
          </svg>
          <span class="visually-hidden">{t('nav.theme')}</span>
        </button>

        <nav class="lang-switch" aria-label={t('nav.language')}>
          {
            locales.map((loc) => (
              <a
                href={localePath(loc, path)}
                hreflang={loc}
                aria-current={loc === lang ? 'true' : undefined}
              >
                {localeNames[loc]}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="wrap" id="content" tabindex="-1">
      <slot />
    </main>

    <script>
      // Переключатель отталкивается от того, что читатель видит сейчас, —
      // включая тему, пришедшую от системы.
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      const systemDark = matchMedia('(prefers-color-scheme: dark)');

      const current = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');

      // Картинку рисует CSS по data-theme и медиазапросу, скрипту остаётся
      // только озвучить состояние. Пока выбора нет, оно меняется вместе с
      // системной темой — отсюда подписка на matchMedia.
      const sync = () => toggle?.setAttribute('aria-checked', String(current() === 'dark'));

      sync();
      systemDark.addEventListener('change', sync);

      toggle?.addEventListener('click', () => {
        root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
        sync();
        try {
          localStorage.setItem('why:theme', root.dataset.theme);
        } catch {
          /* не критично: тема не переживёт перезагрузку */
        }
      });
    </script>

    <footer class="site-footer">
      <div class="wrap">{t('site.tagline')}</div>
    </footer>
  </body>
</html>
