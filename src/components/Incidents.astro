---
/**
 * Реальные случаи, где та же ошибка уже стоила денег.
 *
 * Галерея, а не столбец: случаи равноправны, порядок между ними ничего не
 * значит, и вертикальный список из них отодвигал бы урок на экран вниз.
 *
 * Карточка показывает первые строки; остальное читатель разворачивает сам.
 * Лента из четырёх абзацев перестаёт быть лентой — её приходится читать, а не
 * просматривать, а этот блок нужен именно для «такое уже было, вот где».
 */
import { useTranslations, type Locale } from '../i18n/ui';

interface Incident {
  title: string;
  text: string;
  url: string;
}

interface Props {
  lang: Locale;
  items: Incident[];
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

{
  items.length > 0 && (
    <section class="incidents" aria-labelledby="incidents-heading">
      <div class="incidents__head">
        <h2 class="incidents__heading" id="incidents-heading">
          {t('lesson.incidents')}
        </h2>
        {/* Мышь крутит галерею колесом, палец — свайпом; кнопки нужны тем, у кого
            нет ни того, ни другого. Показывает их скрипт и только когда лента
            действительно не влезла: крутить нечего — и кнопок нет. */}
        <div class="incidents__controls" data-controls hidden>
          <button
            class="incidents__arrow"
            type="button"
            data-scroll="-1"
            aria-label={t('lesson.incidentsPrev')}
          >
            ←
          </button>
          <button
            class="incidents__arrow"
            type="button"
            data-scroll="1"
            aria-label={t('lesson.incidentsNext')}
          >
            →
          </button>
        </div>
      </div>

      {/* tabindex — требование доступности к прокручиваемой области: без него до
          скрытых карточек не добраться с клавиатуры. Имя ей даёт заголовок. */}
      <ul class="incidents__track" data-incidents tabindex="0" aria-labelledby="incidents-heading">
        {items.map((incident, i) => (
          <li class="incident">
            <h3 class="incident__title">{incident.title}</h3>
            {/* Текст в разметке целиком, обрезает его CSS: так он остаётся в
                поиске по странице и достаётся скринридеру без разворачивания. */}
            <p class="incident__text" id={`incident-text-${i}`}>
              {incident.text}
            </p>
            <button
              class="incident__more"
              type="button"
              data-more
              data-expand={t('lesson.incidentExpand')}
              data-collapse={t('lesson.incidentCollapse')}
              aria-expanded="false"
              aria-controls={`incident-text-${i}`}
              hidden
            >
              {t('lesson.incidentExpand')}
            </button>
            {/* Домен как подпись берётся из самой ссылки: отдельное поле
                рядом с url рано или поздно начинает врать. */}
            <a class="incident__source" href={incident.url} target="_blank" rel="noopener">
              {new URL(incident.url).hostname.replace(/^www\./, '')}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<script>
  import { animate, inView, stagger } from 'motion';

  document.querySelectorAll<HTMLElement>('[data-incidents]').forEach((track) => {
    // Тот же уговор, что и в плеере: при prefers-reduced-motion всё происходит
    // мгновенно, а не «побыстрее».
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const controls = track
      .closest('.incidents')!
      .querySelector<HTMLElement>('[data-controls]')!;
    const arrows = [...controls.querySelectorAll<HTMLButtonElement>('[data-scroll]')];
    const cards = [...track.querySelectorAll<HTMLElement>('.incident')];

    /** Сколько ленте осталось проехать вправо; 0 — всё влезло. */
    const limit = () => track.scrollWidth - track.clientWidth;

    // Отступ в один пиксель: дробный scrollLeft при зуме браузера не доезжает
    // до целого края, и кнопка «вправо» осталась бы вечно активной.
    const atStart = () => track.scrollLeft <= 1;
    const atEnd = () => track.scrollLeft >= limit() - 1;

    function paintArrows() {
      controls.hidden = limit() <= 1;
      for (const arrow of arrows) {
        arrow.disabled = arrow.dataset.scroll === '-1' ? atStart() : atEnd();
      }
    }

    /**
     * «Развернуть» показывается только там, где текст правда обрезан: короткая
     * заметка с кнопкой обещает продолжение, которого нет.
     *
     * Развёрнутые карточки пропускаем — у них обрезки уже нет по построению,
     * и проверка спрятала бы кнопку, которой их сворачивают обратно.
     */
    function paintClamps() {
      for (const card of cards) {
        if (card.dataset.expanded !== undefined) continue;
        const text = card.querySelector<HTMLElement>('.incident__text')!;
        card.querySelector<HTMLElement>('[data-more]')!.hidden =
          text.scrollHeight <= text.clientHeight + 1;
      }
    }

    track.addEventListener('click', (event) => {
      const more = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-more]');
      if (!more) return;

      const card = more.closest<HTMLElement>('.incident')!;
      const text = card.querySelector<HTMLElement>('.incident__text')!;

      // Высота снимается до переключения и после: у обрезанного текста она
      // одна, у полного другая, и обе браузер считает сам. Замер «до» берётся
      // с экрана, поэтому быстрый повторный клик подхватывает анимацию с того
      // места, где её застали, а не прыгает.
      const from = text.getBoundingClientRect().height;
      text.style.height = '';
      const expanded = card.toggleAttribute('data-expanded');
      const to = text.getBoundingClientRect().height;

      more.setAttribute('aria-expanded', String(expanded));
      more.textContent = expanded ? more.dataset.collapse! : more.dataset.expand!;

      if (calm) return;
      animate(
        text,
        { height: [`${from}px`, `${to}px`] },
        { duration: 0.28, ease: [0.22, 1, 0.36, 1] },
      ).finished.then(() => {
        // Инлайновую высоту обязательно убрать: иначе карточка запомнит размер
        // и перестанет перевёрстываться при изменении ширины окна.
        text.style.height = '';
      });
    });

    for (const arrow of arrows) {
      arrow.addEventListener('click', () => {
        // Шаг — видимая ширина ленты минус нахлёст: так следующая карточка
        // встаёт на место предыдущей, а не улетает через одну.
        const step = (track.clientWidth - 48) * Number(arrow.dataset.scroll);
        track.scrollBy({ left: step, behavior: 'smooth' });
      });
    }

    /**
     * Вертикальное колесо над лентой крутит её вбок.
     *
     * Перехват заканчивается на краю: дойдя до последней карточки, лента
     * отдаёт жест странице и та продолжает ехать вниз. Без этого галерея
     * запирала бы прокрутку — из неё нельзя было бы выкрутиться колесом.
     */
    track.addEventListener(
      'wheel',
      (event) => {
        // Горизонтальный жест на трекпаде и зум по ctrl браузер отработает сам.
        if (event.ctrlKey || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
        if (limit() <= 1) return;

        // deltaMode: 0 — пиксели, 1 — строки, 2 — экраны. Firefox шлёт строки.
        const perLine = 16;
        const delta =
          event.deltaY *
          (event.deltaMode === 1 ? perLine : event.deltaMode === 2 ? track.clientWidth : 1);

        if ((delta < 0 && atStart()) || (delta > 0 && atEnd())) return;

        event.preventDefault();
        track.scrollLeft += delta;
      },
      { passive: false },
    );

    track.addEventListener('scroll', paintArrows, { passive: true });
    // Ширина карточек зависит от ширины окна, а вместе с ней меняются и
    // «влезло / не влезло», и число строк, на котором текст обрывается.
    new ResizeObserver(() => {
      paintArrows();
      paintClamps();
    }).observe(track);

    paintArrows();
    paintClamps();

    /**
     * Появление ленты: карточки всплывают по очереди.
     *
     * Прячет их скрипт, а не стили: страница без JS обязана показать случаи, а
     * `opacity: 0` в CSS оставил бы её с пустым местом на этом месте.
     */
    if (!calm) {
      for (const card of cards) card.style.opacity = '0';
      inView(
        track,
        () => {
          animate(
            cards,
            { opacity: [0, 1], y: [12, 0] },
            { duration: 0.45, delay: stagger(0.08), ease: [0.22, 1, 0.36, 1] },
          ).finished.then(() => {
            // Motion оставляет за собой инлайновый transform, а он перебивает
            // подъём карточки под курсором — убираем, анимация своё отыграла.
            for (const card of cards) {
              card.style.opacity = '';
              card.style.transform = '';
            }
          });
        },
        { amount: 0.2 },
      );
    }
  });
</script>
