---
/**
 * Уровни сервиса слоёным пирогом.
 *
 * Абзац рядом перечисляет пять уровней и то, что каждый решает. Список из пяти
 * пунктов в прозе читается как перечисление равноправных вещей, а они вложены
 * друг в друга: запрос входит сверху и проходит их по порядку. Пирог говорит
 * это одной картинкой, а рельса с номерами — что порядок именно такой.
 *
 * Плашка нарисована тем же языком, что и остальная страница: белое поле,
 * волосяная рамка, цветная полоска слева — как у блока «Проблема». Объём даёт
 * скошенная верхняя грань и тень, а не заливка: градиентный пирог рядом с
 * такой типографикой выглядел бы наклейкой.
 *
 * Подписи приходят props'ами: файл общий для локалей, а подписи — проза.
 * Геометрия здесь, текст — в MDX той локали, где он к месту.
 */
interface Props {
  levels: {
    /**
     * Ключ уровня, одинаковый во всех локалях: по нему слой связан со словом
     * в абзаце рядом (`data-level` на слове). Наведение на одно подсвечивает
     * другое — иначе читателю приходится сверять их глазами по названию.
     */
    key: string;
    name: string;
    decides: string;
  }[];
  /** Подпись под картинкой: она же кнопка, запускающая проезд запроса. */
  inbound?: string;
}

const { levels, inbound } = Astro.props;

const SLAB = 56;
const GAP = 12;
/** Скос верхней грани: он и делает из плашки слой. */
const SKEW = 10;
/** Жёлоб слева под номерами уровней и рельсой между ними. */
const GUTTER = 30;

const WIDTH = 360;
const TOP = SKEW + 6;
const height = levels.length * (SLAB + GAP) - GAP + TOP + 6;

const plateX = GUTTER;
const plateW = WIDTH - GUTTER - SKEW - 4;

/** Центр слоя по вертикали: по нему стоят номер и подписи. */
const midY = (i: number) => TOP + i * (SLAB + GAP) + SLAB / 2;
const railFrom = midY(0);
const railTo = midY(levels.length - 1);
---

<div class="levels" data-levels>
  <div class="levels__text">
    <slot />
  </div>

  <figure class="levels-cake">
    <svg
      viewBox={`0 0 ${WIDTH} ${height}`}
      role="img"
      aria-label={levels.map((level) => `${level.name}: ${level.decides}`).join('. ')}
    >
      {/* Рельса под номерами: путь запроса. Проложена всегда — она объясняет,
          что уровни идут в порядке, ещё до того, как по ней что-то поехало. */}
      <line class="lvl-rail" x1={GUTTER / 2} y1={railFrom} x2={GUTTER / 2} y2={railTo} />
      <line
        class="lvl-rail lvl-rail--done"
        x1={GUTTER / 2}
        y1={railFrom}
        x2={GUTTER / 2}
        y2={railTo}
        style={`--rail: ${railTo - railFrom}`}
        data-progress
      />

      {
        levels.map((level, i) => {
          const y = TOP + i * (SLAB + GAP);
          const mid = midY(i);
          return (
            <g
              class="lvl"
              style={`--i: ${i}`}
              data-level={level.key}
              tabindex="0"
              role="button"
              aria-label={`${level.name}: ${level.decides}`}
            >
              {/* Верхняя грань рисуется первой: лицевая ложится поверх её
                  нижнего края, иначе он перечёркивает плашку. */}
              <path
                class="lvl__top"
                d={`M ${plateX + SKEW} ${y - SKEW} H ${plateX + plateW + SKEW} L ${plateX + plateW} ${y} H ${plateX} Z`}
              />
              <path
                class="lvl__side"
                d={`M ${plateX + plateW} ${y} L ${plateX + plateW + SKEW} ${y - SKEW} V ${y + SLAB - SKEW} L ${plateX + plateW} ${y + SLAB} Z`}
              />
              <rect class="lvl__face" x={plateX} y={y} width={plateW} height={SLAB} rx="6" />
              {/* Полоска слева: чем ниже уровень, тем она насыщеннее. */}
              <rect class="lvl__bar" x={plateX} y={y + 1} width="3" height={SLAB - 2} rx="1.5" />

              <text class="lvl__name" x={plateX + 16} y={mid - 4}>{level.name}</text>
              <text class="lvl__decides" x={plateX + 16} y={mid + 14}>{level.decides}</text>

              <circle class="lvl__mark" cx={GUTTER / 2} cy={mid} r="10" />
              <text class="lvl__num" x={GUTTER / 2} y={mid}>{i + 1}</text>
            </g>
          );
        })
      }
    </svg>

    {
      inbound && (
        <figcaption>
          <button class="levels-cake__run" type="button" data-run>
            <span class="levels-cake__run-glyph" aria-hidden="true">
              <svg viewBox="0 0 12 12"><path d="M4 2.5 9 6l-5 3.5z" /></svg>
            </span>
            {inbound}
          </button>
        </figcaption>
      )
    }
  </figure>
</div>

<script>
  /**
   * Три вещи, которых картинке не хватает статикой.
   *
   * 1. Слои появляются по одному, когда до них доскроллили: порядок сверху
   *    вниз виден движением, а не только положением.
   * 2. Наведение на слой подсвечивает парное слово в абзаце, и наоборот. Связь
   *    между текстом и картинкой иначе остаётся на совести читателя.
   * 3. Запрос проходит уровни по порядку: номер уровня загорается, рельса за
   *    ним дорастает. Это то, что подпись говорит словами.
   *
   * Всё это украшение: без JS картинка остаётся полной и читаемой, поэтому
   * ничего не рисуется скриптом и ничего им не скрывается.
   */
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-levels]').forEach((root) => {
    const layers = [...root.querySelectorAll<SVGGElement>('.lvl')];
    const progress = root.querySelector<SVGLineElement>('[data-progress]');
    const run = root.querySelector<HTMLButtonElement>('[data-run]');
    /** Слова в абзаце рядом, помеченные тем же ключом уровня. */
    const words = new Map<string, HTMLElement[]>();

    root.querySelectorAll<HTMLElement>('.levels__text [data-level]').forEach((node) => {
      const key = node.dataset.level!;
      words.set(key, [...(words.get(key) ?? []), node]);
    });

    // 1. Появление по одному.
    if (calm) {
      root.classList.add('is-in');
    } else {
      const seen = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            root.classList.add('is-in');
            seen.disconnect();
          }
        },
        { threshold: 0.3 },
      );
      seen.observe(root);
    }

    // 2. Связь слоя со словом.
    const link = (key: string, on: boolean) => {
      for (const layer of layers) {
        if (layer.dataset.level === key) layer.classList.toggle('is-linked', on);
      }
      for (const word of words.get(key) ?? []) word.classList.toggle('is-linked', on);
    };

    for (const layer of layers) {
      const key = layer.dataset.level!;
      layer.addEventListener('pointerenter', () => link(key, true));
      layer.addEventListener('pointerleave', () => link(key, false));
      layer.addEventListener('focus', () => link(key, true));
      layer.addEventListener('blur', () => link(key, false));
    }

    for (const [key, nodes] of words) {
      for (const word of nodes) {
        word.addEventListener('pointerenter', () => link(key, true));
        word.addEventListener('pointerleave', () => link(key, false));
      }
    }

    // 3. Проход запроса.
    let running = false;
    const travel = async () => {
      if (running || calm || !progress) return;
      running = true;
      root.classList.add('is-running');

      const full = Number(getComputedStyle(progress).getPropertyValue('--rail')) || 0;
      const last = layers.length - 1;

      for (const [i, layer] of layers.entries()) {
        // Рельса дорастает до текущего номера: остаток прячется dashoffset'ом,
        // потому что длина линии в SVG сама по себе не анимируется.
        progress.style.strokeDashoffset = String(full - (full * i) / last);
        layer.classList.add('is-lit');
        await new Promise((done) => setTimeout(done, 320));
        layer.classList.remove('is-lit');
      }

      progress.style.strokeDashoffset = String(full);
      root.classList.remove('is-running');
      running = false;
    };

    run?.addEventListener('click', travel);
  });
</script>
