---
/**
 * Уровни сервиса: пирог справа, уровни слева, листаются прокруткой.
 *
 * Пять уровней в одном абзаце читаются как перечисление равноправных вещей, а
 * они вложены друг в друга, и запрос проходит их по порядку. Поэтому уровень
 * здесь — шаг: пирог прилипает, читатель скроллит, слой загорается, и рядом
 * появляется его текст. Тот же приём, которым устроен разбор ниже, — и по той
 * же причине: порядок виден движением, а не только положением.
 *
 * Подписи и тексты приходят props'ами: файл общий для локалей, а проза
 * переводится. Геометрия здесь, слова — в MDX той локали, где они к месту.
 */
interface Props {
  levels: {
    /**
     * Ключ уровня, одинаковый во всех локалях: по нему слой на пироге связан
     * со своим шагом и со словом в абзаце-вступлении (`data-level` на слове).
     */
    key: string;
    name: string;
    /** Строка на плашке: что уровень решает. */
    decides: string;
    /** Текст шага: то же самое, но фразой. */
    text: string;
  }[];
}

const { levels } = Astro.props;

const SLAB = 56;
const GAP = 12;
/** Жёлоб слева под номерами уровней и рельсой между ними. */
const GUTTER = 30;

const WIDTH = 360;
const TOP = 6;
const height = levels.length * (SLAB + GAP) - GAP + TOP * 2;

const plateX = GUTTER;
const plateW = WIDTH - GUTTER - 4;

/** Центр слоя по вертикали: по нему стоят номер и подписи. */
const midY = (i: number) => TOP + i * (SLAB + GAP) + SLAB / 2;
const railFrom = midY(0);
const railTo = midY(levels.length - 1);
---

<div class="levels" data-levels>
  <div class="levels__intro">
    <slot />
  </div>

  <figure class="levels-cake" data-levels-cake>
    <svg
      viewBox={`0 0 ${WIDTH} ${height}`}
      role="img"
      aria-label={levels.map((level) => `${level.name}: ${level.decides}`).join('. ')}
    >
      {/* Рельса под номерами: путь запроса. Проложена всегда — она объясняет,
          что уровни идут в порядке, ещё до того, как по ней что-то поехало. */}
      <line class="lvl-rail" x1={GUTTER / 2} y1={railFrom} x2={GUTTER / 2} y2={railTo} />
      <line
        class="lvl-rail lvl-rail--done"
        x1={GUTTER / 2}
        y1={railFrom}
        x2={GUTTER / 2}
        y2={railTo}
        style={`--rail: ${railTo - railFrom}`}
        data-progress
      />

      {
        levels.map((level, i) => {
          const y = TOP + i * (SLAB + GAP);
          const mid = midY(i);
          return (
            <g
              class="lvl"
              style={`--i: ${i}`}
              data-level={level.key}
              tabindex="0"
              role="button"
              aria-label={`${level.name}: ${level.decides}`}
            >
              <rect class="lvl__face" x={plateX} y={y} width={plateW} height={SLAB} rx="8" />
              {/* Полоска слева: чем ниже уровень, тем она насыщеннее. */}
              <rect class="lvl__bar" x={plateX} y={y + 1} width="3" height={SLAB - 2} rx="1.5" />

              <text class="lvl__name" x={plateX + 16} y={mid - 4}>{level.name}</text>
              <text class="lvl__decides" x={plateX + 16} y={mid + 14}>{level.decides}</text>

              <circle class="lvl__mark" cx={GUTTER / 2} cy={mid} r="10" />
              <text class="lvl__num" x={GUTTER / 2} y={mid}>{i + 1}</text>
            </g>
          );
        })
      }
    </svg>
  </figure>

  <ol class="levels__steps">
    {
      levels.map((level, i) => (
        <li class="levels__step" data-level-step={level.key}>
          <div class="levels__head">
            <span class="levels__index" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="levels__name">{level.name}</h3>
              <p class="levels__decides">{level.decides}</p>
            </div>
          </div>
          <p class="levels__text">{level.text}</p>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { animate, stagger } from 'motion';

  /**
   * Уровни листаются прокруткой: активен тот, чей текст дошёл до линии чтения.
   *
   * Линия — верхняя треть экрана, то есть то место, куда смотрят при чтении;
   * та же величина, что у разбора ниже. Активный слой загорается, рельса за
   * ним дорастает, остальные приглушаются.
   *
   * Без JS видны все пять шагов и весь пирог: скрипт ничего не рисует и ничего
   * не скрывает, он только отмечает активное.
   */
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-levels]').forEach((root) => {
    const layers = [...root.querySelectorAll<SVGGElement>('.lvl')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-level-step]')];
    const progress = root.querySelector<SVGLineElement>('[data-progress]');
    const words = new Map<string, HTMLElement[]>();
    if (steps.length < 2) return;

    root.querySelectorAll<HTMLElement>('.levels__intro [data-level]').forEach((node) => {
      const key = node.dataset.level!;
      words.set(key, [...(words.get(key) ?? []), node]);
    });

    root.classList.add('is-enhanced');

    // Проявление один раз: шаг въезжает в экран, текст поднимается и остаётся.
    if (!calm) {
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const step = entry.target as HTMLElement;
            reveal.unobserve(step);
            step.style.removeProperty('opacity');
            animate(
              step.querySelectorAll<HTMLElement>('.levels__head, .levels__text'),
              { opacity: [0, 1], transform: ['translateY(12px)', 'translateY(0px)'] },
              { duration: 0.46, delay: stagger(0.07), easing: [0.22, 0.9, 0.24, 1] },
            );
          }
        },
        { threshold: 0.2 },
      );

      for (const step of steps) {
        step.style.opacity = '0';
        reveal.observe(step);
      }
    }

    let active = -1;

    const mark = (to: number) => {
      if (to === active) return;
      active = to;
      const key = steps[to].dataset.levelStep!;

      for (const layer of layers) layer.classList.toggle('is-lit', layer.dataset.level === key);
      for (const [step, i] of steps.map((step, i) => [step, i] as const)) {
        step.classList.toggle('is-active', i === to);
      }
      for (const [wordKey, nodes] of words) {
        for (const word of nodes) word.classList.toggle('is-linked', wordKey === key);
      }

      // Рельса дорастает до активного номера: остаток прячется dashoffset'ом,
      // потому что длина линии в SVG сама по себе не анимируется.
      if (progress) {
        const full = Number(getComputedStyle(progress).getPropertyValue('--rail')) || 0;
        progress.style.strokeDashoffset = String(full - (full * to) / (steps.length - 1));
      }

    };

    const readingTop = () => window.innerHeight * 0.34;

    /**
     * Прокрутка к шагу уровня: пирог служит ещё и навигацией.
     *
     * Цель — линия чтения, та же, по которой определяется активный шаг: иначе
     * щелчок привёл бы к уровню, который тут же сменился бы соседним.
     */
    const goTo = (i: number) => {
      // Отметка ставится сразу, а не по приезде: плавная прокрутка идёт
      // полсекунды, и всё это время подсвечен был бы прежний уровень. Пока
      // едем, прокрутка активный шаг не пересчитывает — иначе промежуточные
      // кадры перебивали бы цель.
      navigating = true;
      mark(i);
      // Пара пикселей за линию чтения: ровно на ней шаг считается ещё не
      // дошедшим, и по приезде подсветка сползала бы на предыдущий.
      const top = window.scrollY + steps[i].getBoundingClientRect().top - readingTop() + 2;
      window.scrollTo({ top, behavior: calm ? 'auto' : 'smooth' });
      settle();
    };

    for (const [i, layer] of layers.entries()) {
      layer.addEventListener('click', () => goTo(i));
      layer.addEventListener('keydown', (event) => {
        const key = (event as KeyboardEvent).key;
        if (key !== 'Enter' && key !== ' ') return;
        event.preventDefault();
        goTo(i);
      });
    }

    let frame = 0;
    let navigating = false;
    let settleTimer: ReturnType<typeof setTimeout>;
    const settle = () => {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(() => {
        navigating = false;
        follow();
      }, 220);
    };

    const follow = () => {
      if (navigating) return;
      const boundary = readingTop();
      let next = 0;
      steps.forEach((step, i) => {
        if (step.getBoundingClientRect().top <= boundary) next = i;
      });
      mark(next);
    };

    window.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(follow);
        // Пока страница едет к выбранному уровню, таймер сдвигается: приезд
        // считается закончившимся, когда прокрутка остановилась.
        if (navigating) settle();
      },
      { passive: true },
    );
    follow();
  });
</script>
