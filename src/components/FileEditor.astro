---
import { Code } from 'astro:components';
/**
 * Иконки типов файлов — codicons, набор самого VS Code.
 *
 * Подключается стилем, а не компонентом `vscode-icon`: тот требует ссылку на
 * codicon.css с определённым id в самой странице, а слот дерева лежит в
 * светлом DOM, и обычному элементу со классом codicon хватает стилей страницы.
 */
import '@vscode/codicons/dist/codicon.css';
import { codeTransformers } from '../code/shiki';
import { useTranslations, type Locale } from '../i18n/ui';
import type { FileTreeSpec } from '../code/tree';

interface Props {
  lang: Locale;
  tree: FileTreeSpec;
  /** Отрендеренные документы локали — для файлов дерева без кода. */
  docs?: { path: string; Content: any }[];
  /** Порядок шагов разбора: по нему считается, что в дереве уже появилось. */
  order: string[];
}

const { lang, tree, docs = [], order } = Astro.props;
const doc = (path: string) => docs.find((item) => item.path === path)?.Content;
const t = useTranslations(lang);

const shikiOptions = {
  themes: { light: 'github-light', dark: 'github-dark' },
  transformers: codeTransformers(),
} as const;

/**
 * Номер шага, на котором файл появляется. Скрипту нужен номер, а не id: он
 * сравнивает «появился ли уже» с номером текущего шага, а id для этого
 * пришлось бы каждый раз искать в списке.
 */
const appearsAt = (step: string) => {
  const index = order.indexOf(step);
  if (index === -1) throw new Error(`FileEditor: шаг "${step}" не существует в разборе`);
  return index;
};

/**
 * Дерево каталогов из плоских путей.
 *
 * Каталог появляется вместе с первым своим файлом, поэтому его номер шага —
 * минимум по содержимому. Считать это в компоненте, а не объявлять в спеке,
 * обязательно: иначе каталог и файл в нём разъезжаются по шагам, и в дереве
 * висит пустая папка.
 */
type Node =
  | { kind: 'file'; name: string; path: string; step: number }
  | { kind: 'dir'; name: string; path: string; step: number; children: Node[] };

function build(files: FileTreeSpec['files'], dirs: NonNullable<FileTreeSpec['dirs']>): Node[] {
  const roots: Node[] = [];

  /**
   * Каталог по пути, вместе со всеми, кто над ним. Возвращает его содержимое —
   * уровень, на который кладут файл или вложенный каталог.
   */
  const open = (path: string, step: number): Node[] => {
    let level = roots;
    let prefix = '';

    for (const name of path.split('/')) {
      prefix = prefix ? `${prefix}/${name}` : name;

      let dir = level.find((node) => node.kind === 'dir' && node.name === name);
      if (!dir) {
        dir = { kind: 'dir', name, path: prefix, step, children: [] };
        level.push(dir);
      }
      dir.step = Math.min(dir.step, step);
      level = (dir as Extract<Node, { kind: 'dir' }>).children;
    }

    return level;
  };

  for (const file of files) {
    const parts = file.path.split('/');
    const name = parts.pop()!;
    const step = appearsAt(file.from);
    const level = parts.length ? open(parts.join('/'), step) : roots;
    level.push({ kind: 'file', name, path: file.path, step });
  }

  /* Пустые каталоги идут после файлов: если каталог назван и там, и там, шаг у
     него берётся минимальный — тот, на котором он появился раньше. */
  for (const dir of dirs) open(dir.path, appearsAt(dir.from));

  const sort = (nodes: Node[]): Node[] =>
    nodes
      .map((node) => (node.kind === 'dir' ? { ...node, children: sort(node.children) } : node))
      // Каталоги выше файлов, дальше по алфавиту: так же, как их показывает
      // любой файловый менеджер, и читателю не надо привыкать заново.
      .sort((a, b) =>
        a.kind === b.kind ? a.name.localeCompare(b.name) : a.kind === 'dir' ? -1 : 1,
      );

  return sort(roots);
}

const nodes = build(tree.files, tree.dirs ?? []);

/**
 * Иконка по расширению.
 *
 * Набор намеренно короткий: у codicons нет иконки на каждый язык, и подбирать
 * похожую — значит врать о типе файла. Неизвестное расширение получает обычный
 * лист бумаги, как в редакторе без темы иконок.
 */
const LEAF_ICONS: Record<string, string> = {
  md: 'markdown',
  json: 'json',
  yml: 'settings-gear',
  yaml: 'settings-gear',
  sql: 'database',
  go: 'file-code',
  ts: 'file-code',
  tsx: 'file-code',
  js: 'file-code',
  py: 'file-code',
  rs: 'file-code',
  java: 'file-code',
  kt: 'file-code',
  lean: 'file-code',
};

const leafIcon = (name: string) =>
  LEAF_ICONS[name.split('.').pop()?.toLowerCase() ?? ''] ?? 'file';
---

<div class="editor" data-editor data-view="both">
  <nav class="editor__tree" aria-label={t('lesson.files')}>
    <p class="editor__root">{tree.root}</p>
    {/*
      Дерево рисует `vscode-tree` из VS Code Elements — UI-кит самого
      редактора. Своя разметка выглядела самоделкой: шевроны, направляющие,
      метрика строки и подсветка выделения в редакторе выверены, и повторять их
      руками значит повторять их хуже.

      Элементы вложены как есть, светлым DOM: до регистрации компонента и без
      JS остаётся тот же список имён с отступами (стили ниже), а после — живое
      дерево редактора.
    */}
    <vscode-tree indent-guides="always">
      {(function branch(list: Node[]) {
        return list.map((node) =>
          node.kind === 'dir' ? (
            <vscode-tree-item
              branch
              {...(node.children.length > 0 ? { open: true } : {})}
              data-appears={node.step}
              hidden={node.step > 0}
            >
              <span class="codicon codicon-folder" slot="icon-branch" aria-hidden="true" />
              <span
                class="codicon codicon-folder-opened"
                slot="icon-branch-opened"
                aria-hidden="true"
              />
              {node.name}
              {branch(node.children)}
            </vscode-tree-item>
          ) : (
            <vscode-tree-item
              data-file={node.path}
              data-appears={node.step}
              hidden={node.step > 0}
            >
              <span
                class={`codicon codicon-${leafIcon(node.name)}`}
                slot="icon-leaf"
                aria-hidden="true"
              />
              {node.name}
            </vscode-tree-item>
          ),
        );
      })(nodes)}
    </vscode-tree>
  </nav>

  <div class="editor__panes">
    {
      tree.files.map((file) => {
        const Document = doc(file.path);
        return (
          <div class="editor__pane" data-pane={file.path} hidden>
            <div class="editor__path">{tree.root}/{file.path}</div>
            {Document ? (
              /* Документ показывается отрендеренным, а не исходником: таблица,
                 ради которой он написан, в виде разметки не читается. */
              <div class="editor__doc">
                <Document />
              </div>
            ) : (
              <Code code={file.code!} lang={(file.lang ?? 'text') as any} {...shikiOptions} />
            )}
          </div>
        );
      })
    }
  </div>
</div>

<script>
  import { animate, stagger } from 'motion';
  /* Регистрация веб-компонентов дерева: импорт и есть регистрация. */
  import '@vscode-elements/elements/dist/vscode-tree/index.js';
  import '@vscode-elements/elements/dist/vscode-tree-item/index.js';

  /**
   * Дерево растёт вместе с разбором, а выбор файла остаётся за читателем.
   *
   * Шаг открывает свой файл — тот, о котором он говорит. Но если читатель
   * открыл другой, следующий шаг его выбор не отменяет: у шага без своего файла
   * в карте `open` открытым остаётся то, что было.
   */
  const player = document.querySelector<HTMLElement>('[data-player]');
  /**
   * Экземпляров редактора может быть несколько — по одному на шаг, который его
   * просит. Каждый ведётся отдельно и слушает шаги сам: состояние у них одно и
   * то же, а на экране всегда тот, чей шаг читают.
   */
  const editors = [...document.querySelectorAll<HTMLElement>('[data-editor]')];

  if (editors.length && player) {
    const steps = JSON.parse(player.dataset.editorSteps || '{}') as Record<
      string,
      { open?: string; view?: 'tree' | 'file' | 'both' }
    >;
    const order = JSON.parse(player.dataset.editorOrder || '[]') as string[];

    /* Читатель попросил не двигать — не двигаем: дерево и без движения
       показывает то же самое. */
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const wire = (editor: HTMLElement) => {
    const panes = [...editor.querySelectorAll<HTMLElement>('[data-pane]')];
    const files = [...editor.querySelectorAll<HTMLElement>('[data-file]')];
    const rows = [...editor.querySelectorAll<HTMLElement>('[data-appears]')];

    const show = (path: string) => {
      for (const pane of panes) pane.hidden = pane.dataset.pane !== path;
      // Выделение — состояние строки дерева, и держит его сам компонент.
      for (const file of files) (file as any).selected = file.dataset.file === path;
    };

    const grow = (index: number) => {
      /** Строки, которых на прошлом шаге не было: им и достаётся движение. */
      const arrived: HTMLElement[] = [];

      for (const row of rows) {
        const appears = Number(row.dataset.appears);
        const was = row.hidden;
        row.hidden = appears > index;
        // Файл, появившийся именно на этом шаге, помечен: иначе в дереве из
        // десяти строк читателю придётся искать, что изменилось.
        row.classList.toggle('is-new', appears === index);
        if (was && !row.hidden) arrived.push(row);
      }

      /**
       * Появление — движением, а не подменой разметки.
       *
       * Строка, возникшая мгновенно, читается как сбой отрисовки: в дереве
       * что-то изменилось, но что именно — читатель не увидел. Сдвиг слева и
       * задержка по строкам показывают порядок: сперва каталог, потом то, что
       * в нём.
       */
      if (arrived.length && !calm) {
        animate(
          arrived,
          { opacity: [0, 1], transform: ['translateX(-6px)', 'translateX(0)'] },
          { duration: 0.26, delay: stagger(0.045) },
        );
      }
    };

    /* Выбор строки объявляет дерево одним событием на всё дерево; ветку оно
       на том же щелчке само раскрывает и закрывает. */
    editor.querySelector('vscode-tree')?.addEventListener('vsc-tree-select', (event) => {
      const picked = (event as CustomEvent<{ selectedItems: HTMLElement[] }>).detail
        .selectedItems[0];
      if (picked?.dataset.file) show(picked.dataset.file);
    });

    const goTo = (id: string) => {
      const index = order.indexOf(id);
      if (index === -1) return;
      grow(index);

      const step = steps[id] ?? {};
      // Режим панели объявлен шагом: показать дерево, показать файл или и то и
      // другое. Ширины на всё сразу не хватает, и делить её всегда пополам
      // значит всегда показывать половину ненужного.
      editor.dataset.view = step.view ?? 'both';
      if (step.open) show(step.open);
    };

    goTo(player.dataset.stepId || order[0]);
    player.addEventListener('why:step', (event) => {
      goTo((event as CustomEvent<{ id: string }>).detail.id);
    });
    };

    for (const editor of editors) wire(editor);
  }
</script>
