---
import { Code } from 'astro:components';
import { codeTransformers } from '../code/shiki';
import { inlineMarkdown } from '../inline-markdown';
import { proseBlocks } from '../prose';
import FlowDiagram from './FlowDiagram';
import LikeC4Stage from './LikeC4Stage';
import FileEditor from './FileEditor.astro';
import CodePanel from './CodePanel.astro';
import { useTranslations, type Locale } from '../i18n/ui';
import type { CodeDeck } from '../code/types';
import type { FlowSpec } from '../code/flow';
import type { LikeC4Spec } from '../code/likec4';
import type { FileTreeSpec } from '../code/tree';
import type { WidgetSpec } from '../code/widgets';
import LoadCalculator from './widgets/LoadCalculator';
import RequirementSort from './widgets/RequirementSort';
import NoisyNeighbour from './widgets/NoisyNeighbour';
import RequirementsBoard from './widgets/RequirementsBoard';
import RequirementsRecall from './widgets/RequirementsRecall';
import RequirementChips from './widgets/RequirementChips';
import TransactionFlow from './widgets/TransactionFlow';
import JobLifecycle from './widgets/JobLifecycle';
import { likec4model } from '../likec4/generated';

interface NarrationStep {
  id: string;
  title: string;
  narration: string;
  /** Текст стикера поверх схемы, если он у шага есть. */
  note?: string;
  /** Элементы, которые появляются на схеме на этом шаге. */
  added?: { element: string; role: string }[];
}

interface Props {
  lang: Locale;
  steps: NarrationStep[];
  deck: CodeDeck;
  /** Схема разбора, если урок ведёт она, а не код. */
  flow?: FlowSpec;
  /**
   * Разбор ведёт модель LikeC4, а не нарисованная руками схема. Варианты
   * взаимно исключающие: полотно на сцене одно, и двум схемам на нём тесно.
   */
  likec4?: LikeC4Spec;
  /**
   * Правая половина разбора — редактор с деревом файлов, а не панель кода на
   * каждом шаге. Дерево заполняется по шагам, и файл остаётся на месте, когда
   * шаг сменился: урок про раскладку сервиса читается только так.
   */
  tree?: FileTreeSpec;
  /** Отрендеренные документы локали для файлов дерева без кода. */
  docs?: { path: string; Content: any }[];
  /** Локализованные тексты пометок поверх схемы. */
  notes?: { step: string; level: number; text: string }[];
  /** Локализованные тексты комментариев к коду. */
  comments?: Record<string, string>;
  /** Локализованные подписи для перетаскивания карточки в схему. */
  drags?: { step: string; chip: string; slot: string; action?: string; applied?: string; result?: string }[];
  /** Локализованные подписи узлов и рёбер схемы и врезок. */
  labels?: Record<string, string>;
  /**
   * Интерактивные врезки: шаг → калькулятор, сортировка, симулятор.
   *
   * Стоят там же, где кадр схемы: в колонке рядом с текстом своего шага. Разбор
   * системного дизайна без них превращается в чтение чужих выводов — числа
   * названы, но проверить их нечем.
   */
  widgets?: WidgetSpec;
}

const { lang, steps, deck, flow, likec4, tree, docs = [], notes = [], comments = {}, drags = [], labels = {}, widgets } = Astro.props;

if (flow && likec4) {
  throw new Error('StepPlayer: flow и likec4 вместе — схему рисует что-то одно');
}

// Обёртка сцены общая для обоих вариантов: высота, прокрутка, прилипание.
// Отличается только то, что внутри полотна.
const stage = flow ?? likec4;

/**
 * Какая половина разбора показывается на шаге: схема или редактор.
 *
 * Урок идёт сверху вниз и на разных уровнях смотрит на разное: границы
 * контекстов — схемой, код внутри слайса — редактором. Держать для этого два
 * плеера значило бы разорвать один разбор на два, поэтому панель одна, а шаг
 * говорит, что в ней.
 *
 * Шаг объявляет это тем, что для него описано: свой view — схема, свой файл —
 * редактор. Шаг без того и другого оставляет панель прежней.
 */
type Panel = 'diagram' | 'editor' | 'none';

/**
 * Разбор по модели LikeC4 держит кадры внутри шагов, а не в прилипшей панели.
 *
 * Панель была одна на весь разбор и меняла содержимое на смене шага: при
 * быстрой прокрутке подмены шли пачкой, а на стыке с шагом, которому панель не
 * нужна, она возвращалась прижатой к верху окна — отдельно от текста, которому
 * принадлежит. Кадр внутри шага приезжает и уходит вместе со своим текстом:
 * подменять нечего, и перебивать друг друга кадрам нечем.
 *
 * Так же устроен и редактор: дерево с файлами едет внутри своих шагов. Прежде
 * оно жило в прилипшей панели на весь разбор, и итоговый шаг — дерево и файл
 * разом — показывал этот режим рядом с любым соседним шагом.
 *
 * Схема, нарисованная руками (`flow`), остаётся на прилипшей сцене: она одна
 * на весь разбор и по шагам не меняется, а переезжают по ней пометки.
 */
const inStep = Boolean(likec4 || tree || widgets);

/** Шаги с кадром внутри. `wide` — во всю ширину окна, остальные — рядом с текстом. */
const widgetSteps = new Set(Object.keys(widgets ?? {}));
/** Документ требований разбора, если он есть: значок таблицы на правом краю. */
const requirementsData = Object.values(widgets ?? {}).find(
  (widget) => widget.widget === 'requirements',
)?.data as import('../code/widgets').RequirementsData | undefined;

const wideSteps = new Set([
  ...(likec4?.wide ?? []),
  ...Object.entries(widgets ?? {})
    .filter(([, widget]) => widget.wide)
    .map(([step]) => step),
]);

/** Шаги, у которых кадр — схема LikeC4. */
const viewSteps = new Set(Object.keys(likec4?.views ?? {}));

/** Кадр шага: схема или врезка. Место в колонке у них одно. */
const inlineSteps = new Set([...viewSteps, ...widgetSteps]);

/**
 * Шаги, которым нужен редактор.
 *
 * Шаг со своим кадром в этот список не попадает: в колонке уже занято.
 */
const editorSteps = new Set(
  inStep
    ? steps.filter((step) => tree?.steps[step.id] && !inlineSteps.has(step.id)).map((s) => s.id)
    : [],
);

/**
 * У разбора есть шаги без кадра — им отдаётся колонка под кадр.
 *
 * Шаг с кадром или редактором держит текст в своей колонке: ширина строки у
 * таких шагов одна, и абзацы не переверстываются на переходе. Шагу без кадра
 * эта колонка ни к чему — в 24rem помещается несколько слов в строке.
 *
 * Порог «кадров меньше половины» не годился: у разбора задачи кадров стало
 * четырнадцать на двадцать семь шагов, и текст остальных тринадцати сузился
 * обратно. В разборах по схемам шагов без кадра нет вовсе, и правило их не
 * трогает.
 */
const framed = new Set([...inlineSteps, ...Object.keys(tree?.steps ?? {})]);
const proseLed = steps.some((step) => !framed.has(step.id));

const panelOf = (id: string): Panel | undefined =>
  inStep
    ? 'none'
    : flow
      ? 'diagram'
      : tree?.steps[id]
        ? 'editor'
        : undefined;

const panels = Object.fromEntries(
  steps.map((step) => [step.id, panelOf(step.id)]).filter(([, kind]) => kind),
) as Record<string, Panel>;

/**
 * Шаг, которому нечего показать, показывает пустоту — и она читается как
 * сломанный блок. Поэтому у такого шага панели нет вовсе: текст занимает всю
 * ширину, а панель появляется на том шаге, где ей есть что нарисовать.
 *
 * Касается только первого шага: у остальных «нет своей панели» значит «остаётся
 * прежняя», и терять её на полпути разбора нельзя.
 */
if (!panels[steps[0].id]) panels[steps[0].id] = 'none';

// Панель на первом шаге ставится разметкой: без JS читатель видит ту же
// половину, что и с ним, а не обе сразу.
const firstPanel = panels[steps[0].id];

/**
 * Правая колонка нужна там, где есть редактор — коду нужна ширина — и там, где
 * кадры стоят внутри шагов: колонка под кадр берётся из этой же раскладки.
 */
const sideBySide = Boolean(tree || inStep);

/**
 * Код в колоде общий для всех локалей, поэтому комментарии в нём — ключи.
 * Подставляем до подсветки: иначе `{{…}}` попадёт в токены и подсветится.
 */
function localizeComments(code: string): string {
  return code.replace(/\{\{(\w+)\}\}/g, (_, key: string) => comments[key] ?? `{{${key}}}`);
}

/**
 * Ссылка на песочницу Lean.
 *
 * Открывать один фрагмент бессмысленно: `inductive Promo` сам по себе не
 * соберётся. Поэтому собирается файл из всех шагов по текущий включительно —
 * ровно то, что компилируется локально.
 *
 * Маркеры `[!code …]` вырезаются: они управляют подсветкой на странице, а в
 * редакторе были бы мусорными комментариями.
 */
const NOTATION = /^[ \t]*(--|\/\/)[ \t]*\[!code [^\]]*\][ \t]*\r?\n/gm;

function playgroundUrl(index: number): string | undefined {
  const step = merged[index];
  if (step.panel?.lang !== 'lean') return undefined;

  const patches = step.panel.playground ?? [];
  const parts = merged
    .slice(0, index + 1)
    .filter((item) => item.panel?.lang === 'lean' && item.panel.code)
    // Шаг с правкой в файл не дописывается: он меняет то, что уже написано.
    .filter((item) => item.panel!.playground === undefined && !item.panel!.repeatsPrevious)
    .map((item) => item.panel!.code!);

  let code = localizeComments(parts.join('\n\n')).replace(NOTATION, '');
  for (const patch of patches) {
    code = code.replace(localizeComments(patch.find), localizeComments(patch.replace));
  }
  return `https://live.lean-lang.org/#code=${encodeURIComponent(code)}`;
}
const t = useTranslations(lang);

const byId = new Map(deck.map((step) => [step.id, step]));
// Нарратив ведущий: он определяет и порядок, и состав шагов.
// Шаг без кода — легальный случай (диаграммный или чисто концептуальный).
const merged = steps.map((step) => ({ ...step, panel: byId.get(step.id) }));

// Считается один раз на шаг: ссылка длинная, а в разметке она нужна дважды.
const playgrounds = merged.map((_, index) => playgroundUrl(index));

/**
 * Группы шагов, показывающих один и тот же блок кода.
 *
 * Такая группа получает одну панель на всех: она стоит на месте, пока читатель
 * идёт по её шагам, и меняется только подсветка. Три копии одного блока,
 * проезжающие мимо, читались бы как три разных примера.
 */
const groups: number[][] = [];
merged.forEach((step, index) => {
  if (index > 0 && step.panel?.repeatsPrevious) groups[groups.length - 1].push(index);
  else groups.push([index]);
});

/**
 * Шаги, идущие подряд и просящие редактор, объединяются в одну группу.
 *
 * Редактор у группы один и прилипает, пока читатель идёт по её шагам: дерево
 * растёт, файл меняется, а панель стоит на месте. По экземпляру на шаг вместо
 * этого читалось бы как копия за копией одного и того же дерева.
 */
const runs: { steps: number[]; editor: boolean; solo: boolean }[] = [];

for (const group of groups) {
  const editor = group.length === 1 && editorSteps.has(merged[group[0]].id);
  /* Шаг со своим редактором ни к кому не примыкает и никого не принимает. */
  const solo = editor && Boolean(tree?.steps[merged[group[0]].id]?.standalone);
  const last = runs[runs.length - 1];

  if (editor && !solo && last?.editor && !last.solo) last.steps.push(group[0]);
  else runs.push({ steps: group, editor, solo });
}

const shikiOptions = {
  themes: { light: 'github-light', dark: 'github-dark' },
  transformers: codeTransformers(),
} as const;
---

<section
  class:list={[
    'player',
    stage && 'player--diagram',
    /* Скроллителлинг включает любая прилипшая половина разбора — схема,
       редактор или врезка: шаги листаются прокруткой, а половина следует за
       текстом. Без этого плеер уходит в пошаговый режим с кнопками «назад» и
       «дальше», а разбор обязан читаться сверху вниз, как остальные. */
    (stage || tree || widgets) && 'player--scroll',
    sideBySide && 'player--editor',
    /* Шагам без кадра отдаётся колонка под кадр — см. `proseLed`. */
    proseLed && 'player--prose',
  ]}
  data-player
  data-panel={sideBySide ? firstPanel : undefined}
  data-panels={sideBySide ? JSON.stringify(panels) : undefined}
  data-editor-steps={tree && JSON.stringify(tree.steps)}
  data-editor-order={tree && JSON.stringify(merged.map((step) => step.id))}
  aria-label={t('lesson.walkthrough')}
>
  <div class="player__body">
    {/*
      Обёртка нужна только разбору с редактором: прилипает она, а половину
      внутри выбирает шаг. В диаграммном режиме она обязана исчезнуть из
      раскладки (`display: contents`) — иначе схема прилипает к ней, а она
      ровно её высоты, и полоса уезжает вверх вместе с текстом.
    */}
    <div class:list={[sideBySide ? 'player__panel' : 'player__unwrapped']}>
      {
        flow && (
          <figure class="player__stage" style={`--flow-height: ${flow.height}px`}>
            <FlowDiagram
              client:visible
              spec={flow}
              firstStep={merged[0].id}
              notes={notes}
              drags={drags}
              labels={labels}
            />
          </figure>
        )
      }

      {
        tree && !inStep && (
          <aside class="player__editor">
            <FileEditor
              lang={lang}
              tree={tree}
              docs={docs}
              order={merged.map((step) => step.id)}
              comments={comments}
            />
          </aside>
        )
      }
    </div>

    <ol class="player__steps">
      {
        runs.map((run) => {
          const group = run.steps;
          const solo = group.length === 1 && !run.editor;

          const body = (i: number) => (
            <div>
              <p class="step__index">{t('lesson.stepOf', { n: i + 1, total: merged.length })}</p>
              <h3 class="step__title">{merged[i].title}</h3>
              {/* Нарратив — абзацы и списки, отделённые пустой строкой.
                  Пометка вопроса стоит на каждом блоке: опыт прячет весь
                  вопрос, а не его начало. */}
              {proseBlocks(merged[i].narration).map((block) =>
                block.kind === 'ul' ? (
                  <ul
                    class="step__list"
                    data-promo-question={flow?.drop?.step === merged[i].id || undefined}
                  >
                    {block.items.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                ) : (
                  <p
                    class="step__narration"
                    data-promo-question={flow?.drop?.step === merged[i].id || undefined}
                    set:html={block.html}
                  />
                ),
              )}

              {
                /* Требования шага — под его текстом: их тащат в таблицу,
                   которая стоит в колонке рядом. */
                (() => {
                  const widget = widgets?.[merged[i].id];
                  return widget?.widget === 'requirements' ? (
                    <RequirementChips
                      client:visible
                      step={merged[i].id}
                      data={widget.data}
                      labels={labels}
                    />
                  ) : null;
                })()
              }

              {
                /* Новое на схеме — карточками под текстом. Имя и технология
                   из модели LikeC4: подпись обязана совпасть с коробкой на
                   схеме рядом, а текст урока держит только роль. */
                merged[i].added?.length ? (
                  <ul class="added" aria-label={t('lesson.added')}>
                    {merged[i].added!.map((item) => {
                      const element = likec4model.findElement(item.element as never);
                      return (
                        <li class="added__card">
                          <span class="added__label">{t('lesson.added')}</span>
                          <span class="added__name">
                            {element?.title ?? item.element}
                            {element?.technology && (
                              <span class="added__tech">{element.technology}</span>
                            )}
                          </span>
                          <span class="added__role" set:html={inlineMarkdown(item.role)} />
                        </li>
                      );
                    })}
                  </ul>
                ) : null
              }

              {
                drags.find((drag) => drag.step === merged[i].id) && (
                  /* Карточка живёт в тексте, а слот — в схеме: чтобы донести
                     одну до другого, читателю приходится смотреть на обе. */
                  <>
                  <div aria-live="polite" aria-atomic="true" id={`promo-result-${merged[i].id}`}>
                    <p class="promo-result" data-promo-result set:html={inlineMarkdown(drags.find((drag) => drag.step === merged[i].id)!.result ?? '')} />
                  </div>
                  <div class="promo-experiment">
                    <span class="promo-chip" draggable="true" data-drag-chip>
                      <span class="promo-chip__grip" aria-hidden="true">⠿</span>
                      {drags.find((drag) => drag.step === merged[i].id)!.chip}
                    </span>
                    <button
                      class="btn promo-apply"
                      type="button"
                      data-promo-apply
                      data-applied-label={drags.find((drag) => drag.step === merged[i].id)!.applied}
                      aria-expanded="false"
                      aria-controls={`promo-result-${merged[i].id}`}
                    >
                      {drags.find((drag) => drag.step === merged[i].id)!.action ?? drags.find((drag) => drag.step === merged[i].id)!.slot}
                    </button>
                  </div>
                  </>
                )
              }
            </div>
          );

  /**
   * Схема, которая стоит внутри шага, а не в прилипшей панели.
   *
   * Прямым ребёнком шага, а не внутри его текстового блока: у текста
   * ограничена длина строки, и фигура внутри него это ограничение наследует.
   *
   * Коробка у кадра известного размера: ширину даёт раскладка, высоту —
   * колода. Класс решает только ширину — во всю ширину окна под текстом или
   * колонка рядом с текстом.
   */
  const inlineStage = (i: number) =>
    viewSteps.has(merged[i].id) && (
      <figure
        class={wideSteps.has(merged[i].id) ? 'step__wide' : 'step__aside'}
        style={`--flow-height: ${likec4!.heights?.[merged[i].id] ?? likec4!.height}px`}
      >
        <LikeC4Stage
          client:visible
          view={likec4!.views[merged[i].id]}
          tags={(likec4!.tags ?? []).includes(merged[i].id)}
          note={
            likec4!.notes?.[merged[i].id] && merged[i].note
              ? { ...likec4!.notes[merged[i].id], text: merged[i].note!, level: i + 1 }
              : undefined
          }
          bare={(likec4!.bare ?? []).includes(merged[i].id)}
          groups={(likec4!.groups?.[merged[i].id] ?? []).map((group) => ({
            ...group,
            title: labels[group.label] ?? group.label,
          }))}
        />
      </figure>
    );

  /**
   * Врезка шага: та же колонка, что у схемы, но внутри неё читатель что-то
   * двигает. Высоту задаёт не колода, а содержимое: у калькулятора она зависит
   * от числа ползунков, и держать её числом значило бы держать это число в
   * двух местах.
   */
  const inlineWidget = (i: number) => {
    const widget = widgets?.[merged[i].id];
    if (!widget) return null;

    return (
      <div class={wideSteps.has(merged[i].id) ? 'step__wide' : 'step__aside'}>
        {widget.widget === 'load-calculator' && (
          <LoadCalculator client:visible lang={lang} data={widget.data} labels={labels} />
        )}
        {widget.widget === 'requirement-sort' && (
          <RequirementSort client:visible data={widget.data} labels={labels} />
        )}
        {widget.widget === 'noisy-neighbour' && (
          <NoisyNeighbour client:visible data={widget.data} labels={labels} />
        )}
        {widget.widget === 'transaction-flow' && (
          <TransactionFlow client:visible data={widget.data} labels={labels} />
        )}
        {widget.widget === 'job-lifecycle' && (
          <JobLifecycle client:visible data={widget.data} labels={labels} />
        )}
        {widget.widget === 'requirements' && (
          <RequirementsBoard
            client:visible
            step={merged[i].id}
            data={widget.data}
            labels={labels}
          />
        )}
      </div>
    );
  };


          const panel = (i: number) =>
            !tree &&
            merged[i].panel?.code && (
              <CodePanel
                lang={lang}
                caption={merged[i].panel!.caption}
                code={localizeComments(merged[i].panel!.code!)}
                codeLang={merged[i].panel!.lang ?? 'text'}
                output={merged[i].panel!.output}
                outputTone={merged[i].panel!.outputTone}
                runUrl={playgrounds[i]}
                revealOutput={flow?.drop?.step === merged[i].id}
              />
            );

          if (solo) {
            const i = group[0];
            return (
              <li
                class:list={[
                  'step',
                  !merged[i].panel?.code && 'step--text',
                  wideSteps.has(merged[i].id) && 'step--wide',
                  inlineSteps.has(merged[i].id) && !wideSteps.has(merged[i].id) && 'step--aside',
                  i === 0 && 'is-active',
                ]}
                data-step={i}
                data-step-id={merged[i].id}
                aria-current={i === 0 ? 'step' : undefined}
              >
                {body(i)}
                {panel(i)}
                {inlineStage(i)}
                {inlineWidget(i)}
              </li>
            );
          }

          /* Группа шагов с одним редактором: дерево и файл стоят на месте,
             пока читатель идёт по шагам группы. */
          if (run.editor && tree?.steps[merged[group[0]].id]?.wide) {
            const i = group[0];

            /* Итоговый шаг: текст сверху, редактор под ним во всю ширину окна.
               Так дерево и файл видны разом, а в половине ширины не читалось
               бы ни то, ни другое. */
            return (
              <li
                class="step step--text step--wide"
                data-step={i}
                data-step-id={merged[i].id}
              >
                {body(i)}
                <aside class="player__editor step__wide">
                  <FileEditor
                    lang={lang}
                    tree={tree!}
                    docs={docs}
                    order={merged.map((step) => step.id)}
                    scope={[merged[i].id]}
                    comments={comments}
                  />
                </aside>
              </li>
            );
          }

          if (run.editor) {
            return (
              <li class="step-run step-run--editor">
                <div class="step-run__text">
                  {group.map((i) => (
                    <div class="step step--in-run" data-step={i} data-step-id={merged[i].id}>
                      {body(i)}
                    </div>
                  ))}
                </div>
                <aside class="player__editor step__aside">
                  <FileEditor
                    lang={lang}
                    tree={tree!}
                    docs={docs}
                    order={merged.map((step) => step.id)}
                    scope={group.map((i) => merged[i].id)}
                    comments={comments}
                  />
                </aside>
              </li>
            );
          }

          /* Группа шагов с общим блоком кода: панель одна на всех и стоит на
             месте, пока читатель идёт по шагам — меняется только подсветка. */
          return (
            <li class="step-run">
              <div class="step-run__text">
                {group.map((i) => (
                  <div class="step step--in-run" data-step={i} data-step-id={merged[i].id}>
                    {body(i)}
                  </div>
                ))}
              </div>
              <div class="step-run__stage">
                {group.map((i) => (
                  <div class:list={['step-run__slot', i === group[0] && 'is-shown']} data-panel-for={i}>
                    {panel(i)}
                  </div>
                ))}
              </div>
            </li>
          );
        })
      }
    </ol>

  </div>

  <div class="player__controls">
    <button class="btn" type="button" data-prev disabled>← {t('lesson.prev')}</button>
    <div class="player__dots" role="tablist" aria-label={t('lesson.walkthrough')}>
      {
        merged.map((step, i) => (
          <button
            class="player__dot"
            type="button"
            data-goto={i}
            role="tab"
            aria-current={i === 0 ? 'true' : 'false'}
            /* Название шага и в подписи, а не только в подсказке: подсказка
               видна по наведению, а мышь есть не у всех. */
            aria-label={`${t('lesson.stepOf', { n: i + 1, total: merged.length })} — ${step.title}`}
          >
            {/* Внешний span только позиционирует, внутренний анимируется:
                иначе пружина затирала бы центрирующий translateX(-50%). */}
            <span class="player__dot-tip">
              <span class="player__dot-tip__box">{step.title}</span>
            </span>
          </button>
        ))
      }
    </div>
    <button class="btn" type="button" data-next>{t('lesson.next')} →</button>
  </div>
  {/* Таблица требований под рукой — значок на правом краю, рядом с заданием. */}
  {requirementsData && (
    <RequirementsRecall client:idle data={requirementsData} labels={labels} />
  )}
</section>

<p class="hint">{t('lesson.keyboardHint')}</p>

<script>
  import { animate } from 'motion';

  /**
   * Два режима на одних и тех же данных.
   *
   * Со схемой — скроллителлинг: все шаги видны, колонка нарратива прокручивается,
   * схема прилипает и следует за текстом. Страница скроллится обычным образом,
   * перехвата колеса нет.
   *
   * Без схемы — пошаговый плеер: виден один шаг, листается кнопками.
   *
   * Без JS оба режима вырождаются в статью со всеми шагами подряд.
   */
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
    const steps = [...player.querySelectorAll<HTMLElement>('.step')];
    const dots = [...player.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const prev = player.querySelector<HTMLButtonElement>('[data-prev]');
    const next = player.querySelector<HTMLButtonElement>('[data-next]');
    const list = player.querySelector<HTMLElement>('.player__steps')!;
    if (steps.length < 2) return;

    const scrolly = player.classList.contains('player--scroll');

    /**
     * Шаг в адресе: `#step-<id>`.
     *
     * Ссылка ведёт на конкретный шаг и переживает перезагрузку. Пишется через
     * replaceState: в скролл-режиме шаг меняется на каждой прокрутке, и push
     * набил бы историю так, что «назад» перестало бы уводить со страницы.
     *
     * До первой отметки адрес не трогаем: читатель, пришедший без хеша, не
     * должен получить его сам собой.
     */
    const stepHash = (i: number) => `#step-${steps[i].dataset.stepId ?? ''}`;
    const hashIndex = () => steps.findIndex((step, i) => stepHash(i) === location.hash);
    let urlReady = false;
    let hashTimer: ReturnType<typeof setTimeout>;
    /**
     * Адрес пишет тот блок, в котором стоит линия чтения.
     *
     * Выше разбора та же страница ведёт уровни, и у них свой хеш. Пока
     * читатель там, разбор в адрес не лезет: иначе два скрипта переписывали бы
     * хеш друг за другом. В пошаговом режиме линии чтения нет — там шаг
     * меняется только щелчком, и писать всегда правильно.
     */
    let ownsReading = () => true;

    /**
     * Запись откладывается и оборачивается в try.
     *
     * В скролл-режиме шаг меняется на каждой прокрутке, а браузер троттлит
     * частые replaceState и на превышении бросает исключение. Брошенное прямо
     * из колбэка IntersectionObserver, оно убивало подсветку шагов целиком:
     * адрес застывал, и активный шаг вместе с ним.
     */
    function syncHash() {
      clearTimeout(hashTimer);
      hashTimer = setTimeout(() => {
        if (!urlReady || !ownsReading() || location.hash === stepHash(index)) return;
        try {
          history.replaceState(null, '', stepHash(index));
        } catch {
          // Браузер придержал историю — адрес догонит на следующем шаге.
        }
      }, 250);
    }
    const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    let index = 0;
    player.classList.add('is-enhanced');

    /**
     * Какая половина показывается на шаге. Шаг без своей панели оставляет
     * прежнюю: два шага об одном уровне не должны дёргать её туда и обратно.
     */
    const panels = JSON.parse(player.dataset.panels || '{}') as Record<string, string>;
    const showPanel = (id: string | undefined) => {
      const kind = id ? panels[id] : undefined;
      if (kind) player.dataset.panel = kind;
    };
    player.addEventListener('why:step', (event) => {
      showPanel((event as CustomEvent<{ id: string }>).detail.id);
    });

    function mark(to: number) {
      index = Math.max(0, Math.min(steps.length - 1, to));
      steps.forEach((step, i) => {
        step.classList.toggle('is-active', i === index);
        if (i === index) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));

      // Схема живёт в React-острове. Публикуем и состояние, и событие: остров
      // монтируется лениво и к своему появлению может опоздать на пять шагов.
      const stepId = steps[index].dataset.stepId ?? '';
      player.dataset.stepId = stepId;
      syncHash();
      player.dispatchEvent(new CustomEvent('why:step', { detail: { id: stepId, index } }));

      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === steps.length - 1;

      /**
       * Панель группы показывает шаг, на котором читатель стоит. Если он вышел
       * за пределы группы, она держит ближний к нему край: пустая панель на
       * месте кода читалась бы как сбой.
       */
      player.querySelectorAll<HTMLElement>('.step-run__stage').forEach((stage) => {
        const slots = [...stage.querySelectorAll<HTMLElement>('[data-panel-for]')];
        const ids = slots.map((slot) => Number(slot.dataset.panelFor));
        const shown = Math.min(Math.max(index, ids[0]), ids[ids.length - 1]);
        slots.forEach((slot, n) => slot.classList.toggle('is-shown', ids[n] === shown));
        // Прокручиваем только панель, не страницу: нужная строка длинного
        // доказательства должна быть видна под закреплённой схемой.
        requestAnimationFrame(() => {
          const line = stage.querySelector<HTMLElement>('.is-shown .highlighted');
          if (getComputedStyle(stage).position !== 'sticky') return;
          stage.scrollTop = line
            ? Math.max(0, line.getBoundingClientRect().top - stage.getBoundingClientRect().top + stage.scrollTop - 72)
            : 0;
        });
      });
    }

    /* Подсказки и копирование нужны в обоих режимах, поэтому стоят до
       ветвления: раньше они жили внутри scrolly, и в уроке без схемы
       кнопка копирования оставалась скрытой навсегда. */
      /**
     * Подсказки на полосках навигации.
     *
     * Пружина, а не линейное проявление: подсказка живёт доли секунды, и на
     * такой дистанции затухание читается как подвисание, а отскок — как ответ
     * на наведение. Полоски — обычный DOM, поэтому берётся ванильный animate,
     * без React-острова ради одного тултипа.
     */
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const wireTip = (dot: HTMLElement) => {
      const box = dot.querySelector<HTMLElement>('.player__dot-tip__box');
      if (!box) return;

      let leaving: ReturnType<typeof setTimeout>;

      const show = () => {
        clearTimeout(leaving);
        box.style.visibility = 'visible';
        animate(
          box,
          { opacity: 1, y: 0, scale: 1 },
          calm ? { duration: 0 } : { type: 'spring', stiffness: 640, damping: 28 },
        );
      };

      const hide = () => {
        animate(box, { opacity: 0, y: 4, scale: 0.94 }, { duration: calm ? 0 : 0.12 });
        // visibility снимается после ухода: иначе подсказка пропадает рывком,
        // не дождавшись собственной анимации.
        leaving = setTimeout(() => (box.style.visibility = 'hidden'), calm ? 0 : 130);
      };

      dot.addEventListener('pointerenter', show);
      dot.addEventListener('focus', show);
      dot.addEventListener('pointerleave', hide);
      dot.addEventListener('blur', hide);
    };

    /* Полоски уровней дописываются позже, в скролл-режиме, и подсказку им
       вешает та же функция: иначе у клона есть разметка подсказки, но нет
       обработчиков, и при наведении не видно ничего. */
    player.querySelectorAll<HTMLElement>('.player__dot').forEach(wireTip);

    /**
     * Копирование кода. Берём текст из подсвеченного блока, а не из исходной
     * колоды: в разметке уже подставлены локализованные комментарии, и читатель
     * копирует ровно то, что видит.
     */
    if (navigator.clipboard) {
      player.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        button.hidden = false;
        let reset: ReturnType<typeof setTimeout>;

        button.addEventListener('click', async () => {
          const code =
            button.closest('.panel, .editor__pane')?.querySelector('.astro-code')?.textContent ??
            '';
          try {
            await navigator.clipboard.writeText(code);
          } catch {
            // В доступе отказали — молчим и не показываем галочку: соврать о
            // скопированном хуже, чем не отреагировать.
            return;
          }
          clearTimeout(reset);
          button.classList.add('is-copied');
          button.setAttribute('aria-label', button.dataset.copiedLabel ?? '');
          reset = setTimeout(() => {
            button.classList.remove('is-copied');
            button.setAttribute('aria-label', button.dataset.copyLabel ?? '');
          }, 1600);
        });
      });
    }


    if (scrolly) {
      /**
       * Прилипшая половина разбора: полоса схемы сверху или редактор сбоку.
       *
       * Раньше здесь стоял `.player__stage` с восклицательным знаком, и в
       * разборе с редактором весь скролл-режим падал на первом же обращении:
       * шаги не отмечались, прокрутка ничего не листала.
       */
      const stage = player.querySelector<HTMLElement>('.player__stage');
      /** Боковая раскладка: обе половины лежат в одной прилипшей панели. */
      const panel = player.querySelector<HTMLElement>('.player__panel');
      const sticky = panel ?? stage;
      const controls = player.querySelector<HTMLElement>('.player__controls')!;
      const contentTop = (step: HTMLElement) => step.firstElementChild!.getBoundingClientRect().top;

      /**
       * Где начинается область чтения.
       *
       * Под полосой схемы — сразу под ней: середина экрана попадала внутрь
       * схемы и включала шаг, текста которого ещё не видно.
       *
       * В разборе с панелью сбоку полосы нет: текст идёт от самого верха, и
       * берётся верхняя треть экрана — то место, куда смотрят при чтении. От
       * высоты панели эта граница не зависит намеренно: панель меняет
       * содержимое по шагам, а линия чтения от шага к шагу ездить не должна.
       */
      const readingTop = () =>
        stage && !panel ? stage.getBoundingClientRect().height + 24 : window.innerHeight * 0.34;

      ownsReading = () => {
        const box = player.getBoundingClientRect();
        const line = readingTop();
        return box.top <= line && box.bottom > line;
      };
      let navigating = false;
      let scrollFrame = 0;
      let settleTimer: ReturnType<typeof setTimeout>;

      /**
       * Шаги уровней живут выше разбора, но навигация на странице одна.
       *
       * Их полоски дописываются в начало той же строки: щелчок уводит к
       * уровню, активная подсвечивается по той же линии чтения. Разметка
       * клонируется с готовой полоски — подсказка и все состояния достаются
       * вместе с ней.
       */
      const levels = [...document.querySelectorAll<HTMLElement>('[data-level-step]')];
      const dotsRow = player.querySelector<HTMLElement>('.player__dots');
      const levelDots: HTMLElement[] = [];

      if (levels.length > 1 && dotsRow && dots[0]) {
        const batch = document.createDocumentFragment();

        levels.forEach((level, i) => {
          const dot = dots[0].cloneNode(true) as HTMLElement;
          const title = level.querySelector('.levels__name')?.textContent?.trim() ?? '';

          dot.removeAttribute('data-goto');
          dot.classList.add('player__dot--level');
          dot.setAttribute('aria-current', 'false');
          dot.setAttribute('aria-label', title);

          const box = dot.querySelector('.player__dot-tip__box');
          if (box) box.textContent = title;

          dot.addEventListener('click', () => {
            window.scrollTo({
              top: window.scrollY + level.getBoundingClientRect().top - readingTop(),
              behavior: smooth,
            });
          });

          wireTip(dot);
          batch.append(dot);
          levelDots.push(dot);
          void i;
        });

        dotsRow.prepend(batch);
      }

      /**
       * Пока читатель в уровнях, разбор ещё не начался: его полоски гаснут, а
       * горит полоска уровня. Иначе первый шаг разбора выглядел бы активным
       * задолго до того, как до него дошли.
       */
      const markLevels = () => {
        if (!levelDots.length) return;
        const boundary = readingTop() + 8;
        const started = contentTop(steps[0]) <= boundary;
        let active = -1;

        levels.forEach((level, i) => {
          if (level.getBoundingClientRect().top <= boundary) active = i;
        });

        levelDots.forEach((dot, i) =>
          dot.setAttribute('aria-current', String(!started && i === active)),
        );
        if (!started) dots.forEach((dot) => dot.setAttribute('aria-current', 'false'));
      };

      // Активный шаг определяется в области чтения ПОД схемой. Середина
      // всего экрана могла лежать внутри схемы и включать уже скрытый текст.
      const followScroll = () => {
        if (navigating) return;
        const boundary = readingTop() + 8;
        let active = 0;
        steps.forEach((step, i) => {
          if (contentTop(step) <= boundary) active = i;
        });
        if (active !== index) mark(active);
        /* Адрес сверяется на каждой прокрутке, а не только при смене шага:
           запись, пропущенная пока линия чтения стояла в уровнях, иначе
           никогда бы не повторилась. */
        syncHash();
        markLevels();
      };

      const goTo = (to: number, behavior: ScrollBehavior = smooth) => {
        const destination = Math.max(0, Math.min(steps.length - 1, to));
        navigating = true;
        mark(destination);
        window.scrollTo({ top: window.scrollY + contentTop(steps[destination]) - readingTop(), behavior });
        clearTimeout(settleTimer);
        settleTimer = setTimeout(() => { navigating = false; followScroll(); }, 180);
      };

      window.addEventListener('scroll', () => {
        cancelAnimationFrame(scrollFrame);
        scrollFrame = requestAnimationFrame(followScroll);
        clearTimeout(settleTimer);
        settleTimer = setTimeout(() => { navigating = false; followScroll(); }, 180);
      }, { passive: true });

      /**
       * Строка навигации видна, пока на экране уровни или разбор: она у них
       * одна. Над вступлением и под разбором её нет — там навигировать нечем.
       */
      const navHosts = [player, ...document.querySelectorAll<HTMLElement>('[data-levels]')];
      const onScreen = new Set<Element>();

      player.dataset.nav = 'off';

      const navWatch = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }

        player.dataset.nav = onScreen.size ? 'on' : 'off';
      });

      for (const host of navHosts) navWatch.observe(host);

      const measure = () => {
        player.style.setProperty('--reading-top', `${readingTop()}px`);
        player.style.setProperty('--controls-height', `${controls.getBoundingClientRect().height}px`);
        // Высота полосы влияет на линию чтения, поэтому после её измерения
        // активный шаг пересчитывается тут же, не дожидаясь прокрутки.
        followScroll();
      };
      const layout = new ResizeObserver(measure);
      if (sticky) layout.observe(sticky);
      layout.observe(controls);
      measure();

    // Плеер — единственный источник состояния опыта: кнопка, перетаскивание
    // и слот раскрывают один и тот же результат. Он сохраняется между шагами.
    player.addEventListener('why:promo-placed', () => {
      player.dataset.promoPlaced = 'true';
      player.querySelectorAll<HTMLButtonElement>('[data-promo-apply]').forEach((button) => {
        button.setAttribute('aria-expanded', 'true');
        button.disabled = true;
        if (button.dataset.appliedLabel) button.textContent = button.dataset.appliedLabel;
      });
      // Кнопка могла быть ниже сгиба экрана. После замены вопроса ответом
      // возвращаем начало опыта в область чтения, вместе с выводом справа.
      const experiment = steps.findIndex((step) => step.querySelector('[data-promo-apply]'));
      if (experiment >= 0) goTo(experiment, 'auto');
    });
    player.querySelectorAll<HTMLButtonElement>('[data-promo-apply]').forEach((button) => {
      button.addEventListener('click', () => player.dispatchEvent(new CustomEvent('why:promo-placed')));
    });

    // Карточка акции переезжает из текста в схему обычным HTML5-перетаскиванием:
    // React-остров слушает drop у себя, общий словарь между ними — тип данных.
    player.querySelectorAll<HTMLElement>('[data-drag-chip]').forEach((chip) => {
      chip.addEventListener('dragstart', (event) => {
        const transfer = (event as DragEvent).dataTransfer;
        transfer?.setData('application/x-why-promo', '1');
        if (transfer) transfer.effectAllowed = 'copy';
        chip.classList.add('is-dragging');
      });
      chip.addEventListener('dragend', () => chip.classList.remove('is-dragging'));

      // Клик и клавиатура делают то же самое: перетаскивание — улучшение,
      // а не единственный путь. С клавиатуры мышью не потащишь вовсе.
      const place = () => player.dispatchEvent(new CustomEvent('why:promo-placed'));
      chip.addEventListener('click', place);
      chip.addEventListener('keydown', (event) => {
        const key = (event as KeyboardEvent).key;
        if (key === 'Enter' || key === ' ') {
          event.preventDefault();
          place();
        }
      });
    });

    prev?.addEventListener('click', () => goTo(index - 1));
      next?.addEventListener('click', () => goTo(index + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
      player.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') goTo(index - 1);
        if (event.key === 'ArrowRight') goTo(index + 1);
      });
      player.tabIndex = 0;

      const start = hashIndex();
      mark(start >= 0 ? start : 0);
      urlReady = true;
      if (start >= 0) {
        // Браузер восстанавливает прокрутку после перезагрузки и перебивал бы
        // переход по ссылке: на время перехода берём управление себе.
        const restore = history.scrollRestoration;
        history.scrollRestoration = 'manual';
        goTo(start, 'auto');
        requestAnimationFrame(() => {
          goTo(start, 'auto');
          history.scrollRestoration = restore;
        });
        // Восстановление фокуса и загрузка шрифтов могут сдвинуть страницу
        // позже первого кадра. Доводим прямую ссылку после загрузки, но уже
        // не трогаем прокрутку, если читатель начал взаимодействовать.
        let touched = false;
        for (const event of ['pointerdown', 'wheel', 'touchstart', 'keydown']) {
          window.addEventListener(event, () => { touched = true; }, { once: true, passive: true });
        }
        const alignStart = () => requestAnimationFrame(() => {
          if (!touched && hashIndex() === start) goTo(start, 'auto');
        });
        window.addEventListener('pageshow', alignStart, { once: true });
        document.fonts.ready.then(alignStart);
      }

      window.addEventListener('hashchange', () => {
        const to = hashIndex();
        if (to >= 0) goTo(to);
      });
      return;
    }

    let appliedHeight = -1;

    // Высота контейнера фиксируется по активному шагу и едет к ней плавно.
    // Иначе при переключении меняется высота страницы и всё ниже прыгает.
    function syncHeight(animate = true) {
      const height = steps[index].offsetHeight;
      if (height === appliedHeight) return;
      appliedHeight = height;
      if (!animate) list.style.transition = 'none';
      list.style.height = `${height}px`;
      if (!animate) requestAnimationFrame(() => (list.style.transition = ''));
    }

    function render(to: number) {
      mark(to);
      syncHeight();
    }

    // Пересчёт при смене ширины окна и при доезде шрифтов: высота шага
    // зависит от переносов, а те — от того и другого.
    const observer = new ResizeObserver((entries) => {
      if (entries.some((entry) => entry.target === steps[index])) syncHeight(false);
    });
    steps.forEach((step) => observer.observe(step));

    prev?.addEventListener('click', () => render(index - 1));
    next?.addEventListener('click', () => render(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => render(i)));

    player.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') render(index - 1);
      if (event.key === 'ArrowRight') render(index + 1);
    });
    player.tabIndex = 0;

    list.style.transition = 'none';
    const start = hashIndex();
    render(start >= 0 ? start : 0);
    urlReady = true;
    requestAnimationFrame(() => (list.style.transition = ''));

    window.addEventListener('hashchange', () => {
      const to = hashIndex();
      if (to >= 0 && to !== index) render(to);
    });
  });
</script>
