---
import { ICONS } from './icons';

/** Значок лендинга: линия 1.6, скруглённые концы, цвет — от текста. */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
/>
